module

public import FormalConjecturesUtil

/-!
# Tight closure and localization of weak $F$-regularity

Fix a Noetherian commutative ring $R$ of prime characteristic $p > 0$. For an ideal
$I \subseteq R$, Hochster and Huneke [HH90] defined its *tight closure* $I^*$ as the set of
elements $x \in R$ for which there exists $c \in R$ lying outside every minimal prime of $R$
such that $c x^{p^e} \in I^{[p^e]}$ for all sufficiently large $e \in \mathbb{N}$, where
$I^{[p^e]}$ is generated by $\{a^{p^e} : a \in I\}$.

Brenner and Monsky [BM10] constructed a characteristic-$2$ Noetherian domain showing that
formation of tight closure need not commute with localization. It remains open if weak
$F$-regularity ($I^* = I$ for every ideal $I$) is preserved under arbitrary localization (i.e.
implies $F$-regularity).

*References:*
- [Wikipedia: Tight closure](https://en.wikipedia.org/wiki/Tight_closure)
- [HH90] M. Hochster and C. Huneke, *Tight closure, invariant theory, and the Briançon–Skoda
  theorem*, J. Amer. Math. Soc. **3** (1990), no. 1, 31–116.
- [BM10] H. Brenner and P. Monsky, *Tight closure does not commute with localization*, Ann. of
  Math. (2) **171** (2010), no. 1, 571–588.
-/

@[expose] public section

namespace TightClosure

/-- Frobenius bracket power $I^{[p^e]}$, spanned inside `R` by `{a ^ (p ^ e) | a ∈ I}`. -/
def frobeniusBracketPower {R : Type*} [CommRing R] (p : ℕ) (I : Ideal R) (e : ℕ) : Ideal R :=
  Ideal.span ((fun a : R => a ^ (p ^ e)) '' (I : Set R))

/-- Complement $R^\circ$ of the union of all minimal prime ideals of `R`. -/
def nonMinimalPrimeMultipliers (R : Type*) [CommRing R] : Set R :=
  {c : R | ∀ P ∈ minimalPrimes R, c ∉ P}

/-- Tight-closure membership $x \in I^*$ for an ideal `I` in characteristic `p`: there exists
$c \in R^\circ$ such that $c x^{p^e} \in I^{[p^e]}$ for all sufficiently large $e$. -/
def InTightClosure {R : Type*} [CommRing R] (p : ℕ) (I : Ideal R) (x : R) : Prop :=
  ∃ c ∈ nonMinimalPrimeMultipliers R,
    ∀ᶠ e : ℕ in Filter.atTop, c * x ^ (p ^ e) ∈ frobeniusBracketPower p I e

/-- A commutative ring `R` of prime characteristic `p` is *weakly $F$-regular* if every ideal
`I` of `R` is tightly closed ($I^* = I$). -/
def IsWeaklyFRegular (p : ℕ) (R : Type*) [CommRing R] : Prop :=
  ∀ (I : Ideal R) (x : R), InTightClosure p I x → x ∈ I

/-- The multiplicative identity $1$ lies outside every minimal prime ideal of any commutative
ring. -/
@[category API, AMS 13]
theorem one_mem_nonMinimalPrimeMultipliers (R : Type*) [CommRing R] :
    (1 : R) ∈ nonMinimalPrimeMultipliers R := by
  intro P hP
  exact hP.1.1.one_notMem

/-- Every element of an ideal `I` belongs to its tight closure $I^*$. -/
@[category API, AMS 13]
theorem mem_inTightClosure_of_mem {R : Type*} [CommRing R] (p : ℕ) (I : Ideal R) {x : R}
    (hx : x ∈ I) : InTightClosure p I x := by
  refine ⟨1, one_mem_nonMinimalPrimeMultipliers R, Filter.Eventually.of_forall fun _ => ?_⟩
  rw [one_mul]
  exact Ideal.subset_span ⟨x, hx, rfl⟩

/-- In a weakly $F$-regular ring `R` of characteristic `p`, membership $x \in I^*$ holds
precisely when $x \in I$. -/
@[category API, AMS 13]
theorem inTightClosure_iff_of_isWeaklyFRegular {R : Type*} [CommRing R] (p : ℕ)
    (hR : IsWeaklyFRegular p R) (I : Ideal R) (x : R) :
    InTightClosure p I x ↔ x ∈ I :=
  ⟨hR I x, mem_inTightClosure_of_mem p I⟩

/-- In exponential characteristic `p`, `frobeniusBracketPower p I e` agrees with mapping `I`
along `iterateFrobenius R p e`. -/
@[category API, AMS 13]
theorem frobeniusBracketPower_eq_map_iterateFrobenius {R : Type*} [CommRing R] (p : ℕ)
    [ExpChar R p] (I : Ideal R) (e : ℕ) :
    frobeniusBracketPower p I e = Ideal.map (iterateFrobenius R p e) I :=
  rfl

/-- At exponent $e = 0$, the Frobenius bracket power $I^{[p^0]}$ equals $I$. -/
@[category test, AMS 13]
theorem frobeniusBracketPower_zero {R : Type*} [CommRing R] (p : ℕ) (I : Ideal R) :
    frobeniusBracketPower p I 0 = I := by
  simp [frobeniusBracketPower]

/-- For the unit ideal $\top$, $\top^{[p^e]} = \top$ for every $e \in \mathbb{N}$. -/
@[category test, AMS 13]
theorem frobeniusBracketPower_top {R : Type*} [CommRing R] (p : ℕ) (e : ℕ) :
    frobeniusBracketPower p (⊤ : Ideal R) e = ⊤ := by
  rw [Ideal.eq_top_iff_one]
  exact Ideal.subset_span ⟨1, Submodule.mem_top, by simp⟩

/-- For $p \neq 0$, the Frobenius bracket power $\bot^{[p^e]}$ of the zero ideal is $\bot$. -/
@[category test, AMS 13]
theorem frobeniusBracketPower_bot {R : Type*} [CommRing R] {p : ℕ} (hp : p ≠ 0) (e : ℕ) :
    frobeniusBracketPower p (⊥ : Ideal R) e = ⊥ := by
  rw [eq_bot_iff, frobeniusBracketPower, Ideal.span_le]
  rintro _ ⟨a, ha, rfl⟩
  simp only [SetLike.mem_coe, Submodule.mem_bot] at ha ⊢
  rw [ha, zero_pow (pow_ne_zero e hp)]

/-- In an integral domain $R$, $1 \notin \bot^*$ for any $p \neq 0$. -/
@[category test, AMS 13]
theorem not_inTightClosure_bot_one (R : Type*) [CommRing R] [IsDomain R] {p : ℕ} (hp : p ≠ 0) :
    ¬ InTightClosure p (⊥ : Ideal R) 1 := by
  rintro ⟨c, hc, hev⟩
  rcases Filter.eventually_atTop.mp hev with ⟨N, hN⟩
  have hc0 : c = 0 := by
    have hmem := hN N le_rfl
    rwa [frobeniusBracketPower_bot hp N, one_pow, mul_one, Submodule.mem_bot] at hmem
  exact hc ⊥ ⟨⟨Ideal.isPrime_bot, bot_le⟩, fun _ _ _ => bot_le⟩ (by simp [hc0])

/-- **Brenner–Monsky theorem** [BM10]: formation of tight closure need not commute with
localization at a multiplicative subset $S \subseteq R \setminus \{0\}$, even for Noetherian
integral domains of prime characteristic. -/
@[category research solved, question, AMS 13]
theorem brenner_monsky_tight_closure_localization :
    ¬ ∀ (p : ℕ) [Fact p.Prime] (R : Type) [CommRing R] [IsDomain R] [IsNoetherianRing R]
        [CharP R p] (I : Ideal R) (S : Submonoid R), (0 : R) ∉ S →
        {z : Localization S |
          InTightClosure p (Ideal.map (algebraMap R (Localization S)) I) z} =
        (Ideal.span (algebraMap R (Localization S) '' {x : R | InTightClosure p I x}) :
          Set (Localization S)) := by
  sorry

/-- **Localization problem for weak $F$-regularity** [HH90]: does weak $F$-regularity of a
Noetherian commutative ring $R$ of prime characteristic $p$ always pass to localizations
$S^{-1} R$ (making $R$ $F$-regular)? (When $0 \in S$, `Localization S` is the zero ring, in
which every ideal equals $\top$ and `IsWeaklyFRegular` holds trivially.) -/
@[category research open, question, AMS 13]
theorem isWeaklyFRegular_localization :
    ∀ (p : ℕ) [Fact p.Prime] (R : Type) [CommRing R] [IsNoetherianRing R] [CharP R p]
      (S : Submonoid R),
      IsWeaklyFRegular p R → IsWeaklyFRegular p (Localization S) := by
  sorry

end TightClosure
