module

public import FormalConjecturesUtil

/-!
# Borel Conjecture
The borel Conjecture states that a homotopic equivalence $f:M → N$ between closed and aspherical
topological manifolds, is homotopic to a homeomorphism.
*Reference:* [Wikepedia] (https://en.wikipedia.org/wiki/Borel_conjecture)
-/

@[expose] public section

namespace Borel_Conjecture

@[category research open, AMS 54, AMS 55]
theorem Borel_Conjecture

  (M:Type*) (N:Type*)
  (m n:ℕ)
  [TopologicalSpace M] [TopologicalSpace N]
  [T2Space M] [T2Space N]
  [SecondCountableTopology M] [SecondCountableTopology N]
  [ChartedSpace (EuclideanSpace ℝ (Fin m)) M] [ChartedSpace (EuclideanSpace ℝ (Fin n)) N]
  [IsManifold (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin m))) 0 M]
  [IsManifold (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin n))) 0 N]
  [CompactSpace M] [CompactSpace N]

  (f : ContinuousMap.HomotopyEquiv M N ) :

  ( ∀ x : M, ∀ y : N ,
    ( ∀ n : ℕ , n≥2 →
      (Subsingleton (HomotopyGroup.Pi n M x) ∧ Subsingleton (HomotopyGroup.Pi n N y))
    )
  ) →
  ∃ g : M ≃ₜ N , ContinuousMap.Homotopic f.toFun (g : C(M, N)):= by
  sorry

end Borel_Conjecture
