module

public import FormalConjecturesUtil

/-!
# The Boone–Higman Conjecture

Boone and Higman (1974) characterized word-problem decidability algebraically: a group on finitely
many generators admits a soluble word problem precisely when it embeds into a simple subgroup
inside a finitely presented ambient group.

The **Boone–Higman conjecture** strengthens this criterion by asking that the ambient simple group
itself be finitely presented: any group on finitely many generators having a decidable word problem
embeds into a finitely presented simple group. Note that Wikipedia states the Boone–Higman theorem
and conjecture on finite presentations, whereas Boone and Higman (1974) and Belk, Bleak, Matucci,
and Zaremsky (2025) formulate both for arbitrary finitely generated groups.

*References:*
- [Wikipedia: Word problem for groups](https://en.wikipedia.org/wiki/Word_problem_for_groups)
- W. W. Boone and G. Higman, *An algebraic characterization of groups with soluble word problem*,
  J. Austral. Math. Soc. **18** (1974), 41–53.
- J. Belk, C. Bleak, F. Matucci, and M. C. B. Zaremsky, *Progress around the Boone–Higman
  conjecture*, EMS Surv. Math. Sci. (2025), DOI: 10.4171/EMSS/101.
-/

@[expose] public section

namespace BooneHigmanConjecture

/-- A group presentation `PresentedGroup rels` on `Fin n` has decidable word problem when the set
of signed words `w : List (Fin n × Bool)` mapping to `1` in `PresentedGroup rels` satisfies
`ComputablePred`. -/
def HasDecidableWordProblem {n : ℕ} (rels : Set (FreeGroup (Fin n))) : Prop :=
  ComputablePred fun w : List (Fin n × Bool) =>
    PresentedGroup.mk rels (FreeGroup.mk w) = 1

/-- Canceling adjacent inverse letters evaluates to `1` in `FreeGroup (Fin 1)`. -/
@[category test, AMS 3 20]
theorem freeGroup_mk_pair_cancel :
    FreeGroup.mk ([(0, true), (0, false)] : List (Fin 1 × Bool)) = 1 :=
  (FreeGroup.mul_mk (L₁ := [(0, true)]) (L₂ := [(0, false)])).symm.trans
    (mul_inv_cancel (FreeGroup.of 0))

/-- Every presentation on `Fin 0` defines a trivial group with decidable word problem. -/
@[category test, AMS 3 20]
theorem hasDecidableWordProblem_fin_zero (rels : Set (FreeGroup (Fin 0))) :
    HasDecidableWordProblem rels := by
  have hall : ∀ w : List (Fin 0 × Bool), PresentedGroup.mk rels (FreeGroup.mk w) = 1 := by
    rintro (_ | ⟨⟨i, _⟩, _⟩)
    · exact map_one (PresentedGroup.mk rels)
    · exact Fin.elim0 i
  refine ComputablePred.of_eq (p := fun _ => True) (Computable.computablePred (.const true)) ?_
  intro w
  simp [hall w]

/-- Imposing all of `FreeGroup (Fin n)` as relators yields a trivial group with decidable word
problem. -/
@[category test, AMS 3 20]
theorem hasDecidableWordProblem_univ (n : ℕ) :
    HasDecidableWordProblem (Set.univ : Set (FreeGroup (Fin n))) := by
  refine ComputablePred.of_eq (p := fun _ => True) (Computable.computablePred (.const true)) ?_
  intro w
  simp [PresentedGroup.one_of_mem (Set.mem_univ (FreeGroup.mk w))]

/-- **Boone–Higman Theorem** (1974): A group generated by `Fin n` admits a decidable word problem
precisely when it embeds into a simple subgroup inside a finitely presented ambient group.
Wikipedia states this equivalence on finite presentations; Boone and Higman (1974, Theorem I)
proved it for arbitrary finitely generated groups. -/
@[category research solved, AMS 3 20]
theorem boone_higman_characterization {n : ℕ} (rels : Set (FreeGroup (Fin n))) :
    HasDecidableWordProblem rels ↔
      ∃ (K : Type) (_ : Group K) (_ : Group.IsFinitelyPresented K)
        (H : Subgroup K) (_ : IsSimpleGroup H) (φ : PresentedGroup rels →* H),
        Function.Injective φ := by
  sorry

/-- **Boone–Higman Conjecture** (1973): Any group generated by `Fin n` having a decidable word
problem embeds into a finitely presented simple group. Stated here in the finitely generated
generality of Boone–Higman and Belk–Bleak–Matucci–Zaremsky (2025). -/
@[category research open, AMS 3 20]
theorem boone_higman_conjecture {n : ℕ} (rels : Set (FreeGroup (Fin n)))
    (hwp : HasDecidableWordProblem rels) :
    ∃ (G : Type) (_ : Group G) (_ : Group.IsFinitelyPresented G) (_ : IsSimpleGroup G)
      (φ : PresentedGroup rels →* G),
      Function.Injective φ := by
  sorry

/-- **Boone–Higman Conjecture for Finitely Presented Groups**: Any finitely presented group having
a decidable word problem embeds into a finitely presented simple group, matching Wikipedia's
specialization. -/
@[category research open, AMS 3 20]
theorem boone_higman_conjecture.variants.finitely_presented {n : ℕ}
    (S : Finset (FreeGroup (Fin n)))
    (hwp : HasDecidableWordProblem (S : Set (FreeGroup (Fin n)))) :
    ∃ (G : Type) (_ : Group G) (_ : Group.IsFinitelyPresented G) (_ : IsSimpleGroup G)
      (φ : PresentedGroup (S : Set (FreeGroup (Fin n))) →* G),
      Function.Injective φ := by
  sorry

end BooneHigmanConjecture
