module

public import FormalConjecturesUtil

/-!
# Niemenmaa's Conjecture on Inner Mapping Groups of Loops

For a loop $(Q, \cdot, 1)$, its multiplication group
$\operatorname{Mlt}(Q) \le \operatorname{Perm}(Q)$ is generated by left translations
$x \mapsto a \cdot x$ together with right translations $x \mapsto x \cdot a$, and the inner mapping
group $\operatorname{Inn}(Q)$ is the stabilizer of $1 \in Q$ inside $\operatorname{Mlt}(Q)$.

Markku Niemenmaa (2009) proved that every *finite* loop with nilpotent inner mapping group is
centrally nilpotent. **Niemenmaa's conjecture** states that the same implication holds for arbitrary
(possibly infinite) loops. For abelian inner mapping groups, Piroska Csörgő (2007) constructed
finite centrally nilpotent loops of exact class $3$ ("loops of Csörgő type"), whereas whether any
centrally nilpotent loop with abelian $\operatorname{Inn}(Q)$ can have central nilpotency class
strictly exceeding $3$ remains open.

*References:*
- [Wikipedia: List of problems in loop theory and quasigroup
  theory](https://en.wikipedia.org/wiki/List_of_problems_in_loop_theory_and_quasigroup_theory)
- P. Csörgő, *Abelian inner mappings and nilpotency class greater than two*, European J. Combin.
  **28** (2007), no. 3, 858–867.
- M. Niemenmaa, *Finite loops with nilpotent inner mapping groups are centrally nilpotent*,
  Bull. Aust. Math. Soc. **79** (2009), no. 1, 109–114.
-/

@[expose] public section

namespace NiemenmaaConjecture

universe u

/-- A loop $(Q, \cdot, 1)$ is a set with a binary operation and two-sided neutral element $1$ in
which every left translation and every right translation is bijective. -/
structure IsLoop (Q : Type*) [Mul Q] [One Q] : Prop where
  one_mul : ∀ x : Q, 1 * x = x
  mul_one : ∀ x : Q, x * 1 = x
  leftMul_bijective : ∀ a : Q, Function.Bijective (a * ·)
  rightMul_bijective : ∀ a : Q, Function.Bijective (· * a)

/-- Multiplication group $\operatorname{Mlt}(Q) \le \operatorname{Perm}(Q)$ generated by left
translation maps and right translation maps on a loop $Q$. -/
noncomputable def loopMltGroup (Q : Type*) [Mul Q] [One Q] (hQ : IsLoop Q) :
    Subgroup (Equiv.Perm Q) :=
  Subgroup.closure
    ({Equiv.ofBijective (a * ·) (hQ.leftMul_bijective a) | a : Q} ∪
      {Equiv.ofBijective (· * a) (hQ.rightMul_bijective a) | a : Q})

/-- Inner mapping group $\operatorname{Inn}(Q) = \operatorname{Mlt}(Q)_1$, consisting of elements of
$\operatorname{Mlt}(Q)$ fixing $1 \in Q$. -/
noncomputable def loopInnGroup (Q : Type*) [Mul Q] [One Q] (hQ : IsLoop Q) :
    Subgroup (Equiv.Perm Q) :=
  loopMltGroup Q hQ ⊓ MulAction.stabilizer (Equiv.Perm Q) (1 : Q)

/-- Center $Z(Q)$ of a loop $(Q, \cdot, 1)$: elements that commute with every element of $Q$ and
associate with all pairs in $Q$ in every position. -/
def loopCenter (Q : Type*) [Mul Q] [One Q] : Set Q :=
  {z : Q | (∀ x : Q, z * x = x * z) ∧
    ∀ x y : Q,
      z * (x * y) = (z * x) * y ∧
      x * (z * y) = (x * z) * y ∧
      x * (y * z) = (x * y) * z}

/-- Inductive predicate that $Q$ is a centrally nilpotent loop of class at most $c$: class $0$
means $Q$ is a subsingleton loop, and class at most $c + 1$ means $Q$ admits a surjective
multiplicative homomorphism onto a loop $Q'$ of class at most $c$ whose kernel lies in
`loopCenter Q`. -/
def IsCentrallyNilpotentLoopLe : ℕ → ∀ (Q : Type u) [Mul Q] [One Q], Prop
  | 0, Q, _, _ => IsLoop Q ∧ Subsingleton Q
  | c + 1, Q, _, _ =>
      IsLoop Q ∧ ∃ (Q' : Type u) (_ : Mul Q') (_ : One Q') (f : Q →ₙ* Q'),
        Function.Surjective f ∧
          (∀ x : Q, f x = 1 → x ∈ loopCenter Q) ∧
          @IsCentrallyNilpotentLoopLe c Q' _ _

/-- Every group is a loop. -/
@[category API, AMS 20]
theorem isLoop_of_group (G : Type*) [Group G] : IsLoop G :=
  ⟨one_mul, mul_one, fun a => (Equiv.mulLeft a).bijective, fun a => (Equiv.mulRight a).bijective⟩

/-- For any group $G$, `loopCenter G` coincides with `Subgroup.center G`. -/
@[category API, AMS 20]
theorem loopCenter_eq_center (G : Type*) [Group G] :
    loopCenter G = (Subgroup.center G : Set G) := by
  ext z
  simp only [loopCenter, Set.mem_ofPred, SetLike.mem_coe, Subgroup.mem_center_iff]
  refine ⟨fun ⟨hc, _⟩ x => (hc x).symm, fun hc => ⟨fun x => (hc x).symm, fun x y => ?_⟩⟩
  exact ⟨(mul_assoc z x y).symm, (mul_assoc x z y).symm, (mul_assoc x y z).symm⟩

/-- Every left translation of a loop $Q$ belongs to `loopMltGroup Q hQ`. -/
@[category API, AMS 20]
theorem leftMul_mem_loopMltGroup {Q : Type*} [Mul Q] [One Q] (hQ : IsLoop Q) (a : Q) :
    Equiv.ofBijective (a * ·) (hQ.leftMul_bijective a) ∈ loopMltGroup Q hQ :=
  Subgroup.subset_closure (Or.inl ⟨a, rfl⟩)

/-- For any commutative group $G$, the inner mapping group `loopInnGroup G` is trivial. -/
@[category API, AMS 20]
theorem loopInnGroup_commGroup_eq_bot (G : Type*) [CommGroup G] :
    loopInnGroup G (isLoop_of_group G) = ⊥ := by
  let hG := isLoop_of_group G
  let T : Subgroup (Equiv.Perm G) :=
    { carrier := {σ : Equiv.Perm G | ∃ a : G, ∀ x : G, σ x = a * x}
      one_mem' := ⟨1, fun x => (one_mul x).symm⟩
      mul_mem' := by
        rintro σ τ ⟨a, ha⟩ ⟨b, hb⟩
        exact ⟨a * b, fun x => by rw [Equiv.Perm.mul_apply, hb, ha, mul_assoc]⟩
      inv_mem' := by
        rintro σ ⟨a, ha⟩
        refine ⟨a⁻¹, fun x => σ.injective ?_⟩
        have h1 : σ (σ⁻¹ x) = x := by
          rw [← Equiv.Perm.mul_apply, mul_inv_cancel, Equiv.Perm.one_apply]
        rw [h1, ha, ← mul_assoc, mul_inv_cancel, one_mul] }
  have hle : loopMltGroup G hG ≤ T := by
    rw [loopMltGroup, Subgroup.closure_le]
    rintro σ (⟨a, rfl⟩ | ⟨a, rfl⟩)
    · exact ⟨a, fun _ => rfl⟩
    · exact ⟨a, fun x => mul_comm x a⟩
  rw [eq_bot_iff]
  rintro σ ⟨hmlt, hstab⟩
  obtain ⟨a, ha⟩ := hle hmlt
  have h1 : σ 1 = 1 := hstab
  have ha1 : a = 1 := by simpa [ha 1] using h1
  ext x
  simp [ha x, ha1]

/-- Every commutative group is a centrally nilpotent loop of class at most $1$. -/
@[category API, AMS 20]
theorem isCentrallyNilpotentLoopLe_one_of_commGroup (G : Type u) [CommGroup G] :
    IsCentrallyNilpotentLoopLe 1 G := by
  refine ⟨isLoop_of_group G, PUnit.{u + 1}, inferInstance, inferInstance,
    ⟨fun _ => PUnit.unit, fun _ _ => rfl⟩, fun u => ⟨1, Subsingleton.elim _ u⟩,
    fun x _ => ?_, ⟨⟨fun _ => rfl, fun _ => rfl, fun _ => Function.bijective_id,
      fun _ => Function.bijective_id⟩, inferInstance⟩⟩
  rw [loopCenter_eq_center G]
  exact Subgroup.mem_center_iff.mpr fun g => mul_comm g x

/-- No nontrivial structure has central nilpotency class $0$. -/
@[category API, AMS 20]
theorem not_isCentrallyNilpotentLoopLe_zero_of_nontrivial
    (Q : Type u) [Mul Q] [One Q] [Nontrivial Q] :
    ¬ IsCentrallyNilpotentLoopLe 0 Q := by
  rintro ⟨_, hsub⟩
  exact @false_of_nontrivial_of_subsingleton Q _ hsub

/-- Central nilpotency class bounds are monotone: class at most $c$ implies class at most
$c + 1$. -/
@[category API, AMS 20]
theorem isCentrallyNilpotentLoopLe_succ :
    ∀ {c : ℕ} {Q : Type u} [Mul Q] [One Q],
      IsCentrallyNilpotentLoopLe c Q → IsCentrallyNilpotentLoopLe (c + 1) Q
  | 0, Q, _, _, ⟨hQ, hsub⟩ =>
      ⟨hQ, Q, inferInstance, inferInstance, ⟨id, fun _ _ => rfl⟩, Function.surjective_id,
        fun x _ => by
          have hx : x = 1 := Subsingleton.elim x 1
          subst hx
          exact ⟨fun y => by rw [hQ.one_mul, hQ.mul_one],
            fun a b => by simp [hQ.one_mul, hQ.mul_one]⟩,
        hQ, hsub⟩
  | c + 1, _, _, _, ⟨hQ, Q', hMul, hOne, f, hsurj, hker, hQ'⟩ =>
      ⟨hQ, Q', hMul, hOne, f, hsurj, hker,
        @isCentrallyNilpotentLoopLe_succ c Q' hMul hOne hQ'⟩

/-- On the symmetric group $S_3$, `loopInnGroup` is nontrivial. -/
@[category test, AMS 20]
theorem loopInnGroup_perm_fin_three_ne_bot :
    loopInnGroup (Equiv.Perm (Fin 3)) (isLoop_of_group (Equiv.Perm (Fin 3))) ≠ ⊥ := by
  let hG := isLoop_of_group (Equiv.Perm (Fin 3))
  intro hbot
  let a : Equiv.Perm (Fin 3) := Equiv.swap 0 1
  let b : Equiv.Perm (Fin 3) := Equiv.swap 1 2
  let L_a : Equiv.Perm (Equiv.Perm (Fin 3)) := Equiv.ofBijective (a * ·) (hG.leftMul_bijective a)
  let R_ainv : Equiv.Perm (Equiv.Perm (Fin 3)) :=
    Equiv.ofBijective (· * a⁻¹) (hG.rightMul_bijective a⁻¹)
  have hmlt : L_a * R_ainv ∈ loopMltGroup (Equiv.Perm (Fin 3)) hG :=
    Subgroup.mul_mem _ (Subgroup.subset_closure (Or.inl ⟨a, rfl⟩))
      (Subgroup.subset_closure (Or.inr ⟨a⁻¹, rfl⟩))
  have hstab : (L_a * R_ainv) 1 = 1 := by
    change a * (1 * a⁻¹) = 1
    simp
  have hmem : L_a * R_ainv ∈ (⊥ : Subgroup (Equiv.Perm (Equiv.Perm (Fin 3)))) :=
    hbot ▸ ⟨hmlt, hstab⟩
  rw [Subgroup.mem_bot] at hmem
  have hval : a * (b * a⁻¹) = b := by
    change (L_a * R_ainv) b = b
    rw [hmem, Equiv.Perm.one_apply]
  have hne0 : (a * (b * a⁻¹)) (0 : Fin 3) ≠ b 0 := by decide
  exact hne0 (congr_arg (fun g : Equiv.Perm (Fin 3) => g 0) hval)

/-- **Niemenmaa's Theorem** (2009): Every finite loop $Q$ with nilpotent inner mapping group
$\operatorname{Inn}(Q)$ is centrally nilpotent. -/
@[category research solved, AMS 20]
theorem niemenmaa_finite_nilpotent_inner_mapping
    (Q : Type*) [Finite Q] [Mul Q] [One Q] (hQ : IsLoop Q)
    (hnilp : Group.IsNilpotent (loopInnGroup Q hQ)) :
    ∃ c : ℕ, IsCentrallyNilpotentLoopLe c Q := by
  sorry

/-- **Csörgő's Class-$3$ Theorem** (2007): There exists a finite loop $Q$ whose inner mapping group
$\operatorname{Inn}(Q)$ is abelian and whose central nilpotency class is $3$ (class at most $3$,
not at most $2$). Wikipedia defines "Csörgő type" via class $\ge 3$ citing Csörgő's 2004 preprint;
finiteness and exact class $3$ come from Csörgő's published construction (2007). -/
@[category research solved, AMS 20]
theorem csorgo_abelian_inner_mapping_class_three :
    ∃ (Q : Type) (_ : Finite Q) (_ : Mul Q) (_ : One Q) (hQ : IsLoop Q),
      (∀ σ τ : loopInnGroup Q hQ, σ * τ = τ * σ) ∧
      IsCentrallyNilpotentLoopLe 3 Q ∧
      ¬ IsCentrallyNilpotentLoopLe 2 Q := by
  sorry

/-- **Niemenmaa's Conjecture**: Every loop $Q$ whose inner mapping group $\operatorname{Inn}(Q)$ is
nilpotent is centrally nilpotent. -/
@[category research open, AMS 20]
theorem niemenmaa_conjecture
    (Q : Type*) [Mul Q] [One Q] (hQ : IsLoop Q)
    (hnilp : Group.IsNilpotent (loopInnGroup Q hQ)) :
    ∃ c : ℕ, IsCentrallyNilpotentLoopLe c Q := by
  sorry

/-- **Csörgő-Type Loops of Nilpotency Class Above $3$**: Does there exist a centrally nilpotent
loop $Q$ whose inner mapping group $\operatorname{Inn}(Q)$ is abelian and whose central nilpotency
class exceeds $3$? -/
@[category research open, question, AMS 20]
theorem abelian_inner_mapping_class_gt_three :
    ∃ (Q : Type) (_ : Mul Q) (_ : One Q) (hQ : IsLoop Q),
      (∀ σ τ : loopInnGroup Q hQ, σ * τ = τ * σ) ∧
      (∃ c : ℕ, IsCentrallyNilpotentLoopLe c Q) ∧
      ¬ IsCentrallyNilpotentLoopLe 3 Q := by
  sorry

end NiemenmaaConjecture
