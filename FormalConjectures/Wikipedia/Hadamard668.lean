/-- The integer matrix obtained from `H668Rows`, transposed so its columns are the packed rows. -/
def H668Int : Matrix (Fin 668) (Fin 668) ℤ := fun i j =>
  if (H668Rows.get j).getLsb i then 1 else -1

/-- The integer dot product of two packed sign rows. -/
def rowDot (x y : BitVec 668) : ℤ :=
  ∑ k : Fin 668, if x.getLsb k = y.getLsb k then 1 else -1

/-- The packed-row dot product is symmetric. -/
@[category API, AMS 15]
theorem rowDot_comm (x y : BitVec 668) : rowDot x y = rowDot y x := by
  simp only [rowDot, eq_comm]

/-- Every packed sign row has squared norm 668. -/
@[category API, AMS 15]
theorem rowDot_self (x : BitVec 668) : rowDot x x = 668 := by
  simp [rowDot]

/-- Exact finite computation that distinct rows in the upper triangle are orthogonal. -/
@[category test, AMS 15]
theorem H668Rows_orthogonal_upper :
    ∀ i j : Fin 668, i < j → rowDot (H668Rows.get i) (H668Rows.get j) = 0 := by
  native_decide

/-- Exact entries of the Gram matrix of `H668Int`. -/
@[category test, AMS 15]
theorem H668Int_gram_entries :
    ∀ i j, (H668Int.transpose * H668Int) i j =
      (668 : Matrix (Fin 668) (Fin 668) ℤ) i j := by
  intro i j
  rw [Matrix.mul_apply]
  simp only [Matrix.transpose_apply, H668Int]
  have hdot :
      (∑ x, (if (H668Rows.get i).getLsb x then 1 else -1) *
        (if (H668Rows.get j).getLsb x then 1 else -1)) =
        rowDot (H668Rows.get i) (H668Rows.get j) := by
    simp only [rowDot]
    apply Finset.sum_congr rfl
    intro k _
    cases hi : (H668Rows.get i).getLsb k <;>
      cases hj : (H668Rows.get j).getLsb k <;> simp
  rw [hdot]
  rcases lt_trichotomy i j with hij | rfl | hji
  · rw [H668Rows_orthogonal_upper i j hij]
    simp [Matrix.ofNat_apply, ne_of_lt hij]
  · rw [rowDot_self]
    simp [Matrix.ofNat_apply]
  · rw [rowDot_comm, H668Rows_orthogonal_upper j i hji]
    simp [Matrix.ofNat_apply, ne_of_gt hji]

/-- The columns of `H668Int` are pairwise orthogonal and have squared norm 668. -/
@[category test, AMS 15]
theorem H668Int_gram :
    H668Int.transpose * H668Int = (668 : Matrix (Fin 668) (Fin 668) ℤ) := by
  ext i j
  exact H668Int_gram_entries i j

end Hadamard
