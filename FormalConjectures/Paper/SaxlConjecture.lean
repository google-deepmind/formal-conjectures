module

public import FormalConjecturesUtil

/-!
# Saxl's conjecture

Let `ρ_m = (m, m - 1, …, 1)` be the staircase partition of `N_m = m(m+1)/2`. Saxl conjectured in
2012 that the tensor square `S^{ρ_m} ⊗ S^{ρ_m}` of the corresponding complex Specht module
contains every irreducible representation of the symmetric group `S_{N_m}`; equivalently, all
Kronecker coefficients `g(ρ_m, ρ_m, λ)` are positive [PPV16, Conjecture 1.2]. Ikenmeyer proved
this for `λ` comparable to `ρ_m` in the dominance order, and in particular for all hooks
[Ik15, Theorem 2.1 and Corollary 6.1].

*References:*
- [Ik15] C. Ikenmeyer, *The Saxl conjecture and the dominance order*, Discrete Math. 338 (2015),
  1970–1975.
- [PPV16] I. Pak, G. Panova and E. Vallejo, *Kronecker products, characters, partitions, and the
  tensor square conjectures*, Adv. Math. 288 (2016), 702–731.
- [OAI26] OpenAI, *A cyclic polytabloid proof of Saxl's conjecture*. OpenAI Math Release preprint
  (2026).
  https://github.com/openai/math/blob/4eaee87548250b2682affda7d05d947c05554bae/preprints/A-Cyclic-Polytabloid-Proof-of-Saxls-Conjecture-September-24-2026/paper.pdf
-/

@[expose] public section

open scoped TensorProduct

namespace SaxlConjecture

noncomputable section

universe uG uV

/-- Complex-valued functions on words of length `n` over an alphabet of size `d`. -/
abbrev WordSpace (n d : ℕ) := (Fin n → Fin d) → ℂ

/-- The action of `S_n` on `WordSpace n d` by permuting positions. -/
def wordRep (n d : ℕ) : Representation ℂ (Equiv.Perm (Fin n)) (WordSpace n d) where
  toFun g :=
    { toFun := fun f a => f (a ∘ g)
      map_add' := by intros; rfl
      map_smul' := by intros; rfl }
  map_one' := by ext f a; rfl
  map_mul' g h := by ext f a; rfl

/-- The subrepresentation generated by a vector `v`. -/
def cyclic {G : Type uG} {V : Type uV} [Group G] [AddCommGroup V] [Module ℂ V]
    (ρ : Representation ℂ G V) (v : V) : Subrepresentation ρ where
  toSubmodule := Submodule.span ℂ (Set.range fun g : G => ρ g v)
  apply_mem_toSubmodule g := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨h, rfl⟩ := hx
      apply Submodule.subset_span
      exact ⟨g * h, by simp only [map_mul, Module.End.mul_apply]⟩
    | zero => simp
    | add x y hx hy ihx ihy =>
      simpa only [map_add] using Submodule.add_mem _ ihx ihy
    | smul a x hx ih =>
      simpa only [map_smul] using Submodule.smul_mem _ a ih

/-- A tableau of shape `μ`: an enumeration of the cells of `μ` by `Fin n`. -/
abbrev Tableau (n : ℕ) (μ : YoungDiagram) := Fin n ≃ μ.cells

/-- A fixed tableau of shape `μ`; other choices give isomorphic Specht modules. -/
def canonicalTableau {n : ℕ} (μ : YoungDiagram) (hn : μ.card = n) : Tableau n μ :=
  (Fintype.equivFinOfCardEq (by simpa using hn)).symm

/-- The row word of a tableau: position `i` is sent to the row of its cell. -/
def rowWord {n : ℕ} {μ : YoungDiagram} (t : Tableau n μ) : Fin n → Fin (μ.colLen 0) :=
  fun i => ⟨(t i).val.1, YoungDiagram.mem_iff_lt_colLen.mp
    (μ.up_left_mem le_rfl (Nat.zero_le _) (t i).property)⟩

/-- The column group of a tableau: permutations preserving the column of every position. -/
def columnGroup {n : ℕ} {μ : YoungDiagram} (t : Tableau n μ) :
    Subgroup (Equiv.Perm (Fin n)) where
  carrier := {g | ∀ i, (t (g i)).val.2 = (t i).val.2}
  one_mem' := by intro i; rfl
  mul_mem' := by
    intro g h hg hh i
    exact (hg (h i)).trans (hh i)
  inv_mem' := by
    intro g hg i
    have h := hg (g⁻¹ i)
    simpa using h.symm

/-- The polytabloid of `t`: the column-antisymmetrised row tabloid of `t`. -/
def polytabloid {n : ℕ} {μ : YoungDiagram} (t : Tableau n μ) :
    WordSpace n (μ.colLen 0) := by
  classical
  letI := Fintype.ofFinite (columnGroup t)
  exact ∑ g : columnGroup t,
    (((Equiv.Perm.sign (g : Equiv.Perm (Fin n))) : ℤ) : ℂ) •
      wordRep n (μ.colLen 0) (g : Equiv.Perm (Fin n)) (Pi.single (rowWord t) 1)

/-- The Specht module of `t`, as the subrepresentation generated by its polytabloid. -/
def spechtSub {n : ℕ} {μ : YoungDiagram} (t : Tableau n μ) :=
  cyclic (wordRep n (μ.colLen 0)) (polytabloid t)

/-- The underlying space of the Specht module of `t`. -/
abbrev Specht {n : ℕ} {μ : YoungDiagram} (t : Tableau n μ) :=
  (spechtSub t).toSubmodule

/-- The complex representation of `S_n` on the Specht module of `t`. -/
def spechtRep {n : ℕ} {μ : YoungDiagram} (t : Tableau n μ) :
    Representation ℂ (Equiv.Perm (Fin n)) (Specht t) :=
  (spechtSub t).toRepresentation

/-- The Kronecker coefficient `g(α, β, μ)`: the dimension of the space of `S_n`-maps from
`S^μ` to `S^α ⊗ S^β` with the diagonal action. -/
def kronecker {n : ℕ} {α β μ : YoungDiagram}
    (a : Tableau n α) (b : Tableau n β) (t : Tableau n μ) : ℕ :=
  Module.finrank ℂ (Representation.IntertwiningMap (spechtRep t)
    ((spechtRep a).tprod (spechtRep b)))

/-- The staircase partition `(m, m - 1, …, 1)`. -/
def staircase (m : ℕ) : YoungDiagram where
  cells := ((Finset.range m) ×ˢ (Finset.range m)).filter (fun x => x.1 + x.2 < m)
  isLowerSet := by
    intro x y hxy hy
    simp only [Finset.mem_coe, Finset.mem_filter, Finset.mem_product,
      Finset.mem_range] at hy ⊢
    exact ⟨⟨lt_of_le_of_lt hxy.1 hy.1.1, lt_of_le_of_lt hxy.2 hy.1.2⟩,
      lt_of_le_of_lt (Nat.add_le_add hxy.1 hxy.2) hy.2⟩

end

/--
**Saxl's conjecture.** For every `m ≥ 1` and every partition `μ` of `m(m+1)/2`, the Kronecker
coefficient `g(ρ_m, ρ_m, μ)` is positive.

This was proved by an internal OpenAI model in September 2026 [OAI26].
-/
@[category research solved, AMS 5 20]
theorem saxl_conjecture : ∀ (m : ℕ), 1 ≤ m →
    ∀ (μ : YoungDiagram) (hμ : μ.card = (staircase m).card),
      0 < kronecker (canonicalTableau (staircase m) rfl)
        (canonicalTableau (staircase m) rfl) (canonicalTableau μ hμ) := by
  sorry

/-- **Ikenmeyer.** Saxl's conjecture holds when `μ` is a hook, i.e. all cells of `μ` lie in the
first row or the first column [Ik15, Corollary 6.1]. -/
@[category research solved, AMS 5 20]
theorem saxl_conjecture.variants.hook : ∀ (m : ℕ), 1 ≤ m →
    ∀ (μ : YoungDiagram) (hμ : μ.card = (staircase m).card),
      (∀ c ∈ μ.cells, c.1 = 0 ∨ c.2 = 0) →
      0 < kronecker (canonicalTableau (staircase m) rfl)
        (canonicalTableau (staircase m) rfl) (canonicalTableau μ hμ) := by
  sorry

/-- Saxl's conjecture implies the hook case. -/
@[category test, AMS 5 20]
theorem hook_of_saxl_conjecture (h : type_of% saxl_conjecture) :
    type_of% saxl_conjecture.variants.hook :=
  fun m hm μ hμ _ => h m hm μ hμ

end SaxlConjecture
