module

public import FormalConjecturesUtil

/-!
# Line arrangements with the Hirzebruch property

An arrangement of $3n$ lines in the projective plane has the *Hirzebruch property* if each of its
lines meets the others in exactly $n + 1$ points. The reflection arrangements of finite complex
reflection groups of rank $3$ give examples, such as the Ceva arrangements
$(x^m - y^m)(y^m - z^m)(z^m - x^m) = 0$ of the groups $G(m, m, 3)$, and the Klein, Hesse and
Valentiner configurations [Pan18, Section 1].

Hirzebruch asked whether every complex arrangement with this property is a complex reflection
arrangement, that is, projectively equivalent to the reflection arrangement of a finite complex
reflection group [Hir85], [Pan18, Question 1.2]. Panov answered the question positively for real
arrangements: up to projective equivalence there are exactly four of them, the reflection
arrangements of the Coxeter groups $(A_1)^3$, $A_3$, $B_3$ and $H_3$ [Pan18, Theorem 1.1].
Another proof, with the equivalence relation made explicit, is given in [dB26, Corollary 1.3].
The complex case is open.

*References:*
* [Hir85] F. Hirzebruch, *Algebraic surfaces with extreme Chern numbers (report on the thesis of
  Th. Höfer, Bonn 1984)*, Russian Math. Surveys 40 (1985), no. 4, 135–145.
* [Pan18] D. Panov, *Real line arrangements with the Hirzebruch property*, Geom. Topol. 22 (2018),
  no. 5, 2697–2711, [arXiv:1607.07709](https://arxiv.org/abs/1607.07709).
* [dB26] M. de Borbon, *Point-balanced arrangements in the real projective plane and the
  Hirzebruch property*, [arXiv:2610.09826](https://arxiv.org/abs/2610.09826).
-/

@[expose] public section

open scoped LinearAlgebra.Projectivization

namespace Arxiv.«1607.07709»

/-- A line in the projective plane $\mathbb{P}^2(K)$, recorded by the coefficients $(a, b, c)$ of a
linear form $ax + by + cz$ that defines it, up to scaling. -/
@[ext]
structure Line (K : Type*) [Field K] where
  /-- The coefficients of a linear form defining the line, up to scaling. -/
  coeffs : ℙ K (Fin 3 → K)

variable {K : Type*} [Field K]

/-- The point `p` lies on the line `ℓ`. The condition does not depend on the chosen
representatives. -/
def Line.Contains (ℓ : Line K) (p : ℙ K (Fin 3 → K)) : Prop :=
  ℓ.coeffs.rep ⬝ᵥ p.rep = 0

/-- A vertex of the arrangement `A` is a point that lies on at least two lines of `A`. -/
def IsVertex (A : Finset (Line K)) (p : ℙ K (Fin 3 → K)) : Prop :=
  ∃ ℓ₁ ∈ A, ∃ ℓ₂ ∈ A, ℓ₁ ≠ ℓ₂ ∧ ℓ₁.Contains p ∧ ℓ₂.Contains p

/-- The arrangement `A` has the Hirzebruch property if it consists of $3n$ lines and each of its
lines contains exactly $n + 1$ vertices, that is, meets the other lines in exactly $n + 1$
points. -/
def HasHirzebruchProperty (A : Finset (Line K)) : Prop :=
  ∃ n : ℕ, A.card = 3 * n ∧ ∀ ℓ ∈ A, {p | ℓ.Contains p ∧ IsVertex A p}.ncard = n + 1

/-- `g` is a reflection with mirror `ℓ`: the vectors fixed by `g` are exactly the vectors of the
plane in $K^3$ that defines `ℓ`. -/
def IsReflectionWithMirror (g : GL (Fin 3) K) (ℓ : Line K) : Prop :=
  ∀ v : Fin 3 → K, (g : Matrix (Fin 3) (Fin 3) K).mulVec v = v ↔ ℓ.coeffs.rep ⬝ᵥ v = 0

/-- The arrangement `A` is a reflection arrangement: there is a finite subgroup $W$ of
$\mathrm{GL}_3(K)$, generated by reflections, whose mirrors are exactly the lines of `A`.

The group $W$ is not required to be unitary. Conjugating $W$ by $F \in \mathrm{GL}_3(K)$
moves its mirrors by $F$, and for $K = \mathbb{R}$ or $\mathbb{C}$ every finite subgroup of
$\mathrm{GL}_3(K)$ is conjugate to an orthogonal or unitary one. So for these fields
`IsReflectionArrangement A` says exactly that `A` is projectively equivalent to the reflection
arrangement of a finite orthogonal or unitary reflection group. -/
def IsReflectionArrangement (A : Finset (Line K)) : Prop :=
  ∃ W : Subgroup (GL (Fin 3) K), Finite W ∧
    W = Subgroup.closure {g | g ∈ W ∧ ∃ ℓ, IsReflectionWithMirror g ℓ} ∧
    ∀ ℓ, ℓ ∈ A ↔ ∃ g ∈ W, IsReflectionWithMirror g ℓ

/-- The line $x = \zeta y$ in $\mathbb{CP}^2$. -/
noncomputable def lineXY (ζ : ℂ) : Line ℂ :=
  ⟨Projectivization.mk ℂ ![1, -ζ, 0] fun h ↦ by simpa using congrFun h 0⟩

/-- The line $y = \zeta z$ in $\mathbb{CP}^2$. -/
noncomputable def lineYZ (ζ : ℂ) : Line ℂ :=
  ⟨Projectivization.mk ℂ ![0, 1, -ζ] fun h ↦ by simpa using congrFun h 1⟩

/-- The line $z = \zeta x$ in $\mathbb{CP}^2$. -/
noncomputable def lineZX (ζ : ℂ) : Line ℂ :=
  ⟨Projectivization.mk ℂ ![-ζ, 0, 1] fun h ↦ by simpa using congrFun h 2⟩

open scoped Classical in
/-- The Ceva arrangement $(x^m - y^m)(y^m - z^m)(z^m - x^m) = 0$: the $3m$ lines $x = \zeta y$,
$y = \zeta z$ and $z = \zeta x$ with $\zeta^m = 1$. -/
noncomputable def cevaArrangement (m : ℕ) : Finset (Line ℂ) :=
  (Polynomial.nthRoots m (1 : ℂ)).toFinset.biUnion fun ζ ↦ {lineXY ζ, lineYZ ζ, lineZX ζ}

/-- For $m \geq 2$ the Ceva arrangement of $3m$ lines has the Hirzebruch property: each line
contains one point of multiplicity $m$ and $m$ triple points. -/
@[category test, AMS 14 52]
theorem cevaArrangement_hasHirzebruchProperty {m : ℕ} (hm : 2 ≤ m) :
    HasHirzebruchProperty (cevaArrangement m) := by
  sorry

/-- For $m \geq 2$ the Ceva arrangement is the reflection arrangement of $G(m, m, 3)$. -/
@[category test, AMS 14 20 52]
theorem cevaArrangement_isReflectionArrangement {m : ℕ} (hm : 2 ≤ m) :
    IsReflectionArrangement (cevaArrangement m) := by
  sorry

/-- **Hirzebruch's question.** Let $\mathcal{L}$ be an arrangement of $3n$ lines in
$\mathbb{CP}^2$ such that each line meets the others in exactly $n + 1$ points. Is $\mathcal{L}$ a
complex reflection arrangement, that is, projectively equivalent to the reflection arrangement of
a finite complex reflection group? [Hir85], [Pan18, Question 1.2]. -/
@[category research open, question, AMS 14 20 52]
theorem hirzebruch_question :
    ∀ A : Finset (Line ℂ), HasHirzebruchProperty A → IsReflectionArrangement A := by
  sorry

/-- For real arrangements the answer is yes: an arrangement of $3n$ lines in $\mathbb{RP}^2$ in
which each line meets the others in exactly $n + 1$ points is projectively equivalent to the
reflection arrangement of $(A_1)^3$, $A_3$, $B_3$ or $H_3$ [Pan18, Theorem 1.1],
[dB26, Corollary 1.3]. -/
@[category research solved, AMS 14 20 52]
theorem hirzebruch_question_real :
    ∀ A : Finset (Line ℝ), HasHirzebruchProperty A → IsReflectionArrangement A := by
  sorry

end Arxiv.«1607.07709»
