module

public import FormalConjecturesUtil

/-!
# Confidence intervals with an allowance for weak factors

Armstrong, Weidner, and Zeleneev conjecture that the bias allowance of their panel confidence
interval can depend on the number of weak factors. Total rank remains in the preliminary
estimation and weight tuning. The standard error uses the least-squares residual, as in
Theorem 4, and the proposed allowance uses the preliminary residual, as in Remark 4.1.

The model, optimizer relations, conditional moments, uniform stochastic orders, and growth
conditions below specify the mixed-strength class. Singular values are zero-indexed in the
shared API: index zero is the source's $s_1$. The strong-factor condition uses a positive index
count and requires the corresponding singular value to be positive with probability tending
to one. No singular value $s_0$ is used when there are no strong factors.

## References

* T. Armstrong, M. Weidner, and A. Zeleneev,
  [*Robust Estimation and Inference in Panels with Interactive Fixed Effects*]
  (https://arxiv.org/abs/2210.06639v4), May 2025, Definition 2.2, Algorithm 3.1,
  Remark 3.3, Assumptions 2–4, Theorem 4, and Remark 4.1, printed pp. 20–21.
-/

@[expose] public section

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set
open scoped BigOperators Topology NNReal

namespace Arxiv.«2210.06639»

/-- An $N$-by-$T$ real panel matrix. -/
abbrev PanelMatrix (N T : ℕ) := Matrix (Fin N) (Fin T) ℝ

/-- The target regressor is coordinate zero; the remaining coordinates are controls. -/
abbrev Regressors (K N T : ℕ) := Fin (K + 1) → PanelMatrix N T

/-- The design, factor matrix, errors, and latent $H_j,V_j$ decomposition witnesses.
The auxiliary coordinates are neither observed nor included in the conditioning sigma algebra. -/
abbrev Sample (K N T : ℕ) :=
  Regressors K N T × PanelMatrix N T × PanelMatrix N T ×
    Regressors K N T × Regressors K N T

/-- Finite-dimensional latent panel laws use a standard Borel sample space. -/
instance (K N T : ℕ) : StandardBorelSpace (Sample K N T) := by
  let : StandardBorelSpace (PanelMatrix N T) := inferInstance
  let : StandardBorelSpace (Regressors K N T) := inferInstance
  infer_instance

/-- The observed design and response, the inputs to the procedure. -/
abbrev Data (K N T : ℕ) := Regressors K N T × PanelMatrix N T

/-- A joint coefficient and factor fit. -/
abbrev Fit (K N T : ℕ) := (Fin (K + 1) → ℝ) × PanelMatrix N T

/-- A least-squares fit, one weight matrix per coefficient, and the preliminary factor fit. -/
abbrev Output (K N T : ℕ) :=
  Fit K N T × (Fin (K + 1) → PanelMatrix N T) × PanelMatrix N T

/-- The systematic regression component $X\beta+Z\delta$. -/
def regression {K N T : ℕ} (W : Regressors K N T) (θ : Fin (K + 1) → ℝ) :
    PanelMatrix N T := ∑ j, θ j • W j

/-- A structural coefficient vector and a joint law of the design, factors, and errors. -/
structure Experiment (K N T : ℕ) where
  parameter : Fin (K + 1) → ℝ
  law : Measure (Sample K N T)
  probability : IsProbabilityMeasure law

instance {K N T : ℕ} (e : Experiment K N T) : IsProbabilityMeasure e.law := e.probability

/-- The panel equation $Y=W\theta+\Gamma+U$. -/
def response {K N T : ℕ} (e : Experiment K N T) (s : Sample K N T) : PanelMatrix N T :=
  regression s.1 e.parameter + s.2.1 + s.2.2.1

/-- Only the design and response, rather than latent matrices, are observed. -/
def observedData {K N T : ℕ} (e : Experiment K N T) (s : Sample K N T) : Data K N T :=
  (s.1, response e s)

/-- The sigma algebra generated by the regressors and factor matrix. -/
abbrev covariateSigma (K N T : ℕ) : MeasurableSpace (Sample K N T) :=
  MeasurableSpace.comap (fun s : Sample K N T ↦ (s.1, s.2.1)) inferInstance

/-- Conditioning uses a sub-sigma algebra of the full latent panel sample space. -/
@[category API, AMS 62]
lemma covariateSigma_le (K N T : ℕ) :
    covariateSigma K N T ≤ (inferInstance : MeasurableSpace (Sample K N T)) := by
  exact Measurable.comap_le (measurable_fst.prodMk (measurable_fst.comp measurable_snd))

/-- The largest squared entry, with zero for an empty matrix. -/
def maxEntrySquare {N T : ℕ} (A : PanelMatrix N T) : ℝ :=
  ((Finset.univ.sup fun p : Fin N × Fin T ↦ ‖A p.1 p.2‖₊ ^ 2 : ℝ≥0) : ℝ)

/-- The concentration of the squared weights in their largest entry. -/
def lindebergWeight {N T : ℕ} (A : PanelMatrix N T) : ℝ :=
  maxEntrySquare A / A.frobeniusNormSq

/-- The source's tuning parameter, using the total factor-rank bound. -/
def weightTuning (R N T : ℕ) : ℝ := 2 * R * (Real.sqrt N + Real.sqrt T)

/-- A global rank-constrained least-squares fit, as in equation (11). -/
def IsLeastSquaresFit {K N T : ℕ} (R : ℕ) (d : Data K N T) (f : Fit K N T) : Prop :=
  f.2.rank ≤ R ∧ ∀ g : Fit K N T, g.2.rank ≤ R →
    (d.2 - regression d.1 f.1 - f.2).frobeniusNormSq ≤
      (d.2 - regression d.1 g.1 - g.2).frobeniusNormSq

/-- Exact coefficient normalization, control orthogonality, and the Lindeberg cap. -/
def FeasibleWeights {K N T : ℕ} (c : ℝ) (W : Regressors K N T)
    (j : Fin (K + 1)) (A : PanelMatrix N T) : Prop :=
  (∀ k, A.frobeniusInner (W k) = if k = j then 1 else 0) ∧
    0 < A.frobeniusNormSq ∧ lindebergWeight A ≤ c

/-- The source's squared-bias-plus-variance weight objective. -/
def weightObjective {N T : ℕ} (R : ℕ) (A : PanelMatrix N T) : ℝ :=
  A.frobeniusNormSq + (weightTuning R N T) ^ 2 * A.spectralNorm ^ 2

/-- A globally optimal feasible weight matrix, as in equation (16). -/
def IsWeightFit {K N T : ℕ} (R : ℕ) (c : ℝ) (W : Regressors K N T)
    (j : Fin (K + 1)) (A : PanelMatrix N T) : Prop :=
  FeasibleWeights c W j A ∧ ∀ B, FeasibleWeights c W j B →
    weightObjective R A ≤ weightObjective R B

/-- The coefficient-by-coefficient preliminary estimates in step 2. -/
def preliminaryCoefficients {K N T : ℕ} (d : Data K N T) (o : Output K N T) :
    Fin (K + 1) → ℝ :=
  fun j ↦ (o.2.1 j).frobeniusInner (d.2 - o.1.2)

/-- A best rank-at-most-$R$ approximation, as in step 3. -/
def IsRankFit {N T : ℕ} (R : ℕ) (residual G : PanelMatrix N T) : Prop :=
  G.rank ≤ R ∧ ∀ H, H.rank ≤ R →
    (residual - G).frobeniusNormSq ≤ (residual - H).frobeniusNormSq

/-- All three exact optimizer relations defining Algorithm 3.1 with the Lindeberg cap. -/
def IsAlgorithmOutput {K N T : ℕ} (R : ℕ) (c : ℝ)
    (d : Data K N T) (o : Output K N T) : Prop :=
  IsLeastSquaresFit R d o.1 ∧
    (∀ j, IsWeightFit R c d.1 j (o.2.1 j)) ∧
    IsRankFit R (d.2 - regression d.1 (preliminaryCoefficients d o)) o.2.2

/-- Measurable selections for each source optimization problem. Weights depend only on the
regressors. Each stage returns zero if its optimizer relation has no solution. -/
structure Algorithm (K N T R : ℕ) (c : ℝ) where
  leastSquares : Data K N T → Fit K N T
  weights : Regressors K N T → Fin (K + 1) → PanelMatrix N T
  rankFit : PanelMatrix N T → PanelMatrix N T
  measurable_leastSquares : Measurable leastSquares
  measurable_weights : Measurable weights
  measurable_rankFit : Measurable rankFit
  leastSquares_optimal : ∀ d, (∃ f, IsLeastSquaresFit R d f) →
    IsLeastSquaresFit R d (leastSquares d)
  leastSquares_fallback : ∀ d, (¬ ∃ f, IsLeastSquaresFit R d f) → leastSquares d = 0
  weights_optimal : ∀ W j, (∃ A, IsWeightFit R c W j A) → IsWeightFit R c W j (weights W j)
  weights_fallback : ∀ W j, (¬ ∃ A, IsWeightFit R c W j A) → weights W j = 0
  rankFit_optimal : ∀ residual, (∃ G, IsRankFit R residual G) →
    IsRankFit R residual (rankFit residual)
  rankFit_fallback : ∀ residual, (¬ ∃ G, IsRankFit R residual G) → rankFit residual = 0

/-- Applying the three optimizer selections in the order of Algorithm 3.1. -/
def Algorithm.output {K N T R : ℕ} {c : ℝ} (a : Algorithm K N T R c)
    (d : Data K N T) : Output K N T :=
  let f := a.leastSquares d
  let A := a.weights d.1
  let θpre := fun j ↦ (A j).frobeniusInner (d.2 - f.2)
  (f, A, a.rankFit (d.2 - regression d.1 θpre))

/-- The step-4 estimate of the target coefficient. -/
def estimate {K N T : ℕ} (d : Data K N T) (o : Output K N T) : ℝ :=
  (o.2.1 0).frobeniusInner (d.2 - o.2.2)

/-- The preliminary residual used in the proposed allowance. -/
def preliminaryResidual {K N T : ℕ} (d : Data K N T) (o : Output K N T) : PanelMatrix N T :=
  d.2 - regression d.1 (preliminaryCoefficients d o) - o.2.2

/-- The least-squares residual used in Theorem 4's standard error. -/
def leastSquaresResidual {K N T : ℕ} (d : Data K N T) (o : Output K N T) : PanelMatrix N T :=
  d.2 - regression d.1 o.1.1 - o.1.2

/-- The heteroskedasticity-robust standard error from Theorem 4. -/
def standardError {K N T : ℕ} (d : Data K N T) (o : Output K N T) : ℝ :=
  Real.sqrt (∑ i, ∑ t, (o.2.1 0 i t) ^ 2 * (leastSquaresResidual d o i t) ^ 2)

/-- The proposed allowance $2R_w s_1(\widehat U_{\rm pre})(1+\epsilon)$. -/
def weakAllowance {N T : ℕ} (Rw : ℕ) (ε : ℝ) (residual : PanelMatrix N T) : ℝ :=
  2 * Rw * residual.spectralNorm * (1 + ε)

/-- The bias-aware interval with the weak-factor allowance. -/
def interval {K N T R : ℕ} {c : ℝ} (Rw : ℕ) (ε : ℝ) (α : Ioo (0 : ℝ) 1)
    (a : Algorithm K N T R c) (d : Data K N T) : Set ℝ :=
  let o := a.output d
  Statistics.biasAwareInterval (estimate d o)
    (weakAllowance Rw ε (preliminaryResidual d o)) (o.2.1 0).spectralNorm
    (standardError d o) α

/-- Exact coefficient normalization rules out zero weights and a zero denominator. -/
@[category API, AMS 62]
theorem normalizedWeights_normSq_pos {K N T : ℕ} {W : Regressors K N T}
    {j : Fin (K + 1)} {A : PanelMatrix N T}
    (hnormalized : ∀ k, A.frobeniusInner (W k) = if k = j then 1 else 0) :
    0 < A.frobeniusNormSq := by
  by_contra h
  have hzero : A.frobeniusNormSq = 0 :=
    le_antisymm (not_lt.mp h) (Matrix.frobeniusNormSq_nonneg A)
  have hA : A = 0 := (Matrix.frobeniusNormSq_eq_zero_iff A).1 hzero
  simpa [hA] using hnormalized j

/-- The stagewise selector returns an exact source output whenever the three stages are solvable. -/
@[category API, AMS 62]
theorem Algorithm.output_valid {K N T R : ℕ} {c : ℝ} (a : Algorithm K N T R c)
    (d : Data K N T) (hls : ∃ f, IsLeastSquaresFit R d f)
    (hw : ∀ j, ∃ A, IsWeightFit R c d.1 j A)
    (hr : ∃ G, IsRankFit R
      (d.2 - regression d.1 (preliminaryCoefficients d (a.output d))) G) :
    IsAlgorithmOutput R c d (a.output d) := by
  refine ⟨a.leastSquares_optimal d hls, ?_, ?_⟩
  · exact fun j ↦ a.weights_optimal d.1 j (hw j)
  · exact a.rankFit_optimal _ hr

/-- A nonzero single-cell design with a zero response. -/
def singleCellData : Data 0 1 1 := (fun _ _ _ ↦ 1, 0)

/-- Its zero coefficient/factor fits and normalized weight. -/
def singleCellOutput : Output 0 1 1 := ((0, 0), (fun _ _ _ ↦ 1), 0)

/-- The concrete optimizer relations are nonempty, even in the no-factor regression benchmark. -/
@[category API, AMS 62]
theorem singleCellOutput_valid : IsAlgorithmOutput 0 1 singleCellData singleCellOutput := by
  have hreg : regression singleCellData.1 singleCellOutput.1.1 = 0 := by
    ext i t
    simp [regression, singleCellData, singleCellOutput]
    change (0 : ℝ) * 1 = 0
    norm_num
  have hpre : preliminaryCoefficients singleCellData singleCellOutput =
      singleCellOutput.1.1 := by
    ext j
    simp [preliminaryCoefficients, singleCellData, singleCellOutput, Matrix.frobeniusInner]
  refine ⟨?_, ?_, ?_⟩
  · constructor
    · simp [singleCellOutput]
    · intro g _
      rw [hreg]
      simpa [singleCellData, singleCellOutput] using Matrix.frobeniusNormSq_nonneg
        (singleCellData.2 - regression singleCellData.1 g.1 - g.2)
  · intro j
    constructor
    · norm_num [FeasibleWeights, singleCellData, singleCellOutput, lindebergWeight,
        maxEntrySquare, Matrix.frobeniusInner, Matrix.frobeniusNormSq]
      exact fun k ↦ by omega
    · intro B hB
      have hentry : B 0 0 = 1 := by
        simpa [singleCellData, Matrix.frobeniusInner] using hB.1 j
      have hmatrix : B = fun _ _ ↦ 1 := by
        ext i t
        simpa only [Fin.fin_one_eq_zero] using hentry
      rw [hmatrix]
      exact le_rfl
  · constructor
    · simp [singleCellOutput]
    · intro G _
      rw [hpre, hreg]
      simpa [singleCellData, singleCellOutput] using Matrix.frobeniusNormSq_nonneg (-G)

/-- The controls' Gram matrix when coefficient $j$ is the target. -/
def controlsGram {K N T : ℕ} (W : Regressors K N T) (j : Fin (K + 1)) :
    Matrix (Fin K) (Fin K) ℝ :=
  fun k l ↦ (W (j.succAbove k)).frobeniusInner (W (j.succAbove l))

section Families

variable {K : ℕ} {N T : ℕ → ℕ} {Θ : ℕ → Type*}

/-- A family may vary in structural coefficients and in the joint design/error law. -/
abbrev Experiments (K : ℕ) (N T : ℕ → ℕ) (Θ : ℕ → Type*) :=
  ∀ n, Θ n → Experiment K (N n) (T n)

/-- The actual probability laws of the family. -/
def laws (e : Experiments K N T Θ) : ∀ n, Θ n → Measure (Sample K (N n) (T n)) :=
  fun n θ ↦ (e n θ).law

/-- The square-root sample-size rate. -/
def rootNT (N T : ℕ → ℕ) (n : ℕ) : ℝ := Real.sqrt ((N n : ℝ) * T n)

/-- The idiosyncratic spectral rate. -/
def noiseRate (N T : ℕ → ℕ) (n : ℕ) : ℝ := max (Real.sqrt (N n)) (Real.sqrt (T n))

/-- The generalized noncollinearity event in Assumption 2(i). The sum starts at zero-based
index $2R$, which is the source's singular value $s_{2R+1}$. -/
def Noncollinear {K N T : ℕ} (R : ℕ) (squaredBound : ℝ)
    (W : Regressors K N T) : Prop :=
  ∀ γ : Fin (K + 1) → ℝ, (∑ j, γ j ^ 2) = 1 →
    squaredBound ≤ (∑ r ∈ Finset.Ico (2 * R) (min N T),
      (regression W γ).singularValue r ^ 2) / ((N : ℝ) * T)

/-- Assumption 2(i)–(iv), with its rank restriction. All orders are uniform over the family. -/
structure FactorConditions (R : ℕ) (e : Experiments K N T Θ) : Prop where
  rank_bound : ∀ n θ, ∀ᵐ s ∂(e n θ).law, s.2.1.rank ≤ R
  noncollinearity : ∃ b : ℝ, 0 < b ∧ UniformHighProbability (laws e)
    (fun _ _ ↦ {s | Noncollinear R b s.1})
  regressor_scale : ∀ j : Fin (K + 1), UniformOp (laws e)
    (fun _ _ s ↦ (s.1 j).spectralNorm) (rootNT N T)
  error_scale : UniformAsymp (laws e) (fun _ _ s ↦ s.2.2.1.spectralNorm) (noiseRate N T)
  regressor_error : ∀ j : Fin (K + 1), UniformOp (laws e)
    (fun _ _ s ↦ (s.1 j).frobeniusInner s.2.2.1) (rootNT N T)
  singular_gaps : ∀ r : ℕ, UniformLittleOp (laws e)
    (fun _ _ s ↦ (s.2.2.1.spectralNorm - s.2.2.1.singularValue r) / s.2.2.1.spectralNorm)
    (fun _ ↦ 1)

/-- Deterministic coefficients in the latent decomposition for a specified target. -/
structure RegressorDecomposition (K : ℕ) (Θ : ℕ → Type*) where
  coefficient : ∀ n, Θ n → Fin K → ℝ

/-- The auxiliary $H_j$ coordinate of the source's joint latent construction. -/
def auxiliaryH {K N T : ℕ} (s : Sample K N T) (j : Fin (K + 1)) : PanelMatrix N T :=
  s.2.2.2.1 j

/-- The auxiliary $V_j$ coordinate of the source's joint latent construction. -/
def auxiliaryV {K N T : ℕ} (s : Sample K N T) (j : Fin (K + 1)) : PanelMatrix N T :=
  s.2.2.2.2 j

/-- The inverse-Gram stochastic bound includes the singular event in its tail. A singular
Gram matrix is therefore not represented by the totalized matrix inverse's zero value. -/
def InverseGramBound (e : Experiments K N T Θ) (j : Fin (K + 1)) : Prop :=
  ∀ η : ℝ, 0 < η → ∃ C : ℝ, 0 < C ∧ ∀ᶠ n in atTop, ∀ θ,
    (e n θ).law {s | (controlsGram s.1 j).det = 0 ∨
      C / ((N n : ℝ) * T n) ≤ (controlsGram s.1 j)⁻¹.frobeniusNorm} ≤ ENNReal.ofReal η

/-- Every clause of Assumption 3 for one regressor, including the design decomposition and
entrywise tails. The same conditions will be required for every target coordinate. -/
structure DecompositionConditions (e : Experiments K N T Θ) (c : ℕ → ℝ)
    (j : Fin (K + 1)) (d : RegressorDecomposition K Θ) : Prop where
  bounded_coefficient : ∃ C : ℝ, 0 < C ∧ ∀ n θ k, |d.coefficient n θ k| ≤ C
  decomposition : ∀ n θ, ∀ᵐ s ∂(e n θ).law,
    s.1 j = (∑ k, d.coefficient n θ k • s.1 (j.succAbove k)) + auxiliaryH s j + auxiliaryV s j
  V_norm : UniformAsymp (laws e) (fun _ _ s ↦ (auxiliaryV s j).frobeniusNorm) (rootNT N T)
  V_spectral : UniformOp (laws e) (fun _ _ s ↦ (auxiliaryV s j).spectralNorm) (noiseRate N T)
  H_norm : UniformOp (laws e) (fun _ _ s ↦ (auxiliaryH s j).frobeniusNorm) (rootNT N T)
  H_V : UniformOp (laws e) (fun _ _ s ↦ (auxiliaryH s j).frobeniusInner (auxiliaryV s j))
    (rootNT N T)
  controls_norm : ∀ k : Fin K, UniformOp (laws e)
    (fun _ _ s ↦ (s.1 (j.succAbove k)).frobeniusNorm) (rootNT N T)
  controls_V : ∀ k : Fin K, UniformOp (laws e)
    (fun _ _ s ↦ (s.1 (j.succAbove k)).frobeniusInner (auxiliaryV s j)) (rootNT N T)
  inverse_gram : InverseGramBound e j
  V_entries : UniformLittleOp (laws e) (fun _ _ s ↦ maxEntrySquare (auxiliaryV s j))
    (fun n ↦ (N n : ℝ) * T n * c n)
  controls_entries : ∀ k : Fin K, UniformLittleOp (laws e)
    (fun _ _ s ↦ maxEntrySquare (s.1 (j.succAbove k)))
    (fun n ↦ ((N n : ℝ) * T n) ^ 2 * c n)

/-- Conditional independence, centering, nondegenerate variance, and bounded fourth moments
of the errors given the observed regressors and factor matrix, as in Assumption 4. -/
def ConditionalErrorConditions (e : Experiments K N T Θ) : Prop :=
  ∃ σ η : ℝ, 0 < σ ∧ 0 < η ∧ ∀ n θ,
    iCondIndepFun (covariateSigma K (N n) (T n)) (covariateSigma_le K (N n) (T n))
      (fun p : Fin (N n) × Fin (T n) ↦ fun s : Sample K (N n) (T n) ↦ s.2.2.1 p.1 p.2)
      (e n θ).law ∧
    ∀ i t,
      Integrable (fun s : Sample K (N n) (T n) ↦ s.2.2.1 i t) (e n θ).law ∧
      Integrable (fun s : Sample K (N n) (T n) ↦ s.2.2.1 i t ^ 2) (e n θ).law ∧
      Integrable (fun s : Sample K (N n) (T n) ↦ s.2.2.1 i t ^ 4) (e n θ).law ∧
      ∀ᵐ s ∂(e n θ).law,
        ((e n θ).law[fun s ↦ s.2.2.1 i t | covariateSigma K (N n) (T n)]) s = 0 ∧
        σ ^ 2 < ((e n θ).law[fun s ↦ s.2.2.1 i t ^ 2 |
          covariateSigma K (N n) (T n)]) s ∧
        ((e n θ).law[fun s ↦ s.2.2.1 i t ^ 4 | covariateSigma K (N n) (T n)]) s < 1 / η

/-- Theorem 4's primitive hypotheses, with comparable growth for the mixed-strength extension.
Total rank $R$ is used in every preliminary fit and in every weight objective. -/
structure PrimitiveConditions (R : ℕ) (e : Experiments K N T Θ) (c : ℕ → ℝ) : Prop where
  positive_N : ∀ n, 0 < N n
  positive_T : ∀ n, 0 < T n
  grow_N : Tendsto N atTop atTop
  grow_T : Tendsto T atTop atTop
  comparable : ∃ a b : ℝ, 0 < a ∧ 0 < b ∧
    ∀ᶠ n in atTop, a ≤ (N n : ℝ) / T n ∧ (N n : ℝ) / T n ≤ b
  positive_cap : ∀ n, 0 < c n
  vanishing_cap : Tendsto (fun n ↦ c n * max (N n : ℝ) (T n)) atTop (𝓝 0)
  factor : FactorConditions R e
  decompositions : ∀ j : Fin (K + 1), ∃ d : RegressorDecomposition K Θ,
    DecompositionConditions e c j d
  errors : ConditionalErrorConditions e

/-- At least $R_s$ separated strong factors; all remaining factors are unrestricted.
When $R_s=0$ there is no singular-value restriction. When $R_s=r+1$, source $s_{R_s}$ is
shared-API index $r$. -/
def StrongFactorCondition (Rs : ℕ) (e : Experiments K N T Θ) : Prop :=
  ∀ r : ℕ, Rs = r + 1 →
    UniformHighProbability (laws e) (fun _ _ ↦ {s | 0 < s.2.1.singularValue r}) ∧
    UniformLittleOp (laws e)
      (fun _ _ s ↦ s.2.2.1.spectralNorm / s.2.1.singularValue r) (fun _ ↦ 1)

/-- With no strong factors there is no domination hypothesis. -/
@[category API, AMS 62]
theorem strongFactorCondition_zero (e : Experiments K N T Θ) : StrongFactorCondition 0 e := by
  intro r h
  omega

/-- The total-rank tuning becomes ordinary minimum-variance weighting when there are no factors. -/
@[category API, AMS 62]
theorem weightTuning_zero (N T : ℕ) : weightTuning 0 N T = 0 := by
  simp [weightTuning]

/-- The all-strong limit has zero CI allowance, rather than a claim of zero estimation error. -/
@[category API, AMS 62]
theorem weakAllowance_zero {N T : ℕ} (ε : ℝ) (residual : PanelMatrix N T) :
    weakAllowance 0 ε residual = 0 := by
  simp [weakAllowance]

/-- The all-weak allowance is precisely Theorem 4's allowance with total rank. -/
@[category API, AMS 62]
theorem weakAllowance_all_weak {N T : ℕ} (R : ℕ) (ε : ℝ) (residual : PanelMatrix N T) :
    weakAllowance R ε residual = 2 * R * residual.spectralNorm * (1 + ε) := rfl

/-- **Armstrong–Weidner–Zeleneev's weak-factor extension (Remark 4.1).** Under the primitive
uniform conditions and separation of $R_s$ strong factors, the interval using
$2R_w s_1(\widehat U_{\rm pre})(1+\epsilon)$ has asymptotic coverage at least $1-\alpha$.
Preliminary estimation still uses total rank $R_s+R_w$. Measurable selections of the concrete
optimizer relations exist, and every such selection with the stagewise fallback has the coverage
bound. The all-strong and all-weak cases are the source's established boundary regimes. -/
@[category research open, AMS 62 91]
theorem weak_factor_coverage (Rs Rw : ℕ) (e : Experiments K N T Θ) (c : ℕ → ℝ)
