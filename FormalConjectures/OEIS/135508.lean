/-- The covering condition for a single `q`: `q` is not prime, or is `2`, `3` or `5`, or has a
certificate with `P ≤ q ^ 2 - 1`. -/
def coverOK (q : ℕ) : Bool :=
  !primeB q || q == 2 || q == 3 || q == 5 ||
    certs.any fun e => e.1 == q && 1 ≤ e.2.1 && e.2.1 + 1 ≤ q * q

