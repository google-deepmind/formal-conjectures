/-- Every certificate passes `entryOK certs`. -/
@[category API, AMS 11]
lemma entryOK_certs : ∀ e ∈ certs, entryOK certs e = true := by
  intro e he
  simp only [certs, List.mem_append] at he
  rcases he with (((((((((((h0 | h1) | h2) | h3) | h4) | h5) | h6) | h7) | h8) | h9) | h10) | h11) | h12
  · exact List.all_eq_true.mp entryOK_certs0 e h0
  · exact List.all_eq_true.mp entryOK_certs1 e h1
  · exact List.all_eq_true.mp entryOK_certs2 e h2
  · exact List.all_eq_true.mp entryOK_certs3 e h3
  · exact List.all_eq_true.mp entryOK_certs4 e h4
  · exact List.all_eq_true.mp entryOK_certs5 e h5
  · exact List.all_eq_true.mp entryOK_certs6 e h6
  · exact List.all_eq_true.mp entryOK_certs7 e h7
  · exact List.all_eq_true.mp entryOK_certs8 e h8
  · exact List.all_eq_true.mp entryOK_certs9 e h9
  · exact List.all_eq_true.mp entryOK_certs10 e h10
  · exact List.all_eq_true.mp entryOK_certs11 e h11
  · exact List.all_eq_true.mp entryOK_certs12 e h12

/-- `coverOK q` holds for every `q < 10 ^ 4`. -/
@[category API, AMS 11]
lemma coverOK_lt {q : ℕ} (h : q < 10 ^ 4) : coverOK q = true := by
  have key : ∀ i, (List.range' (1000 * i) 1000).all coverOK = true →
      1000 * i ≤ q → q < 1000 * i + 1000 → coverOK q = true := fun i hi h1 h2 =>
    List.all_eq_true.mp hi q (List.mem_range'_1.mpr ⟨h1, h2⟩)
  rcases (by omega : (1000 * 0 ≤ q ∧ q < 1000 * 0 + 1000) ∨ (1000 * 1 ≤ q ∧ q < 1000 * 1 + 1000) ∨ (1000 * 2 ≤ q ∧ q < 1000 * 2 + 1000) ∨ (1000 * 3 ≤ q ∧ q < 1000 * 3 + 1000) ∨ (1000 * 4 ≤ q ∧ q < 1000 * 4 + 1000) ∨ (1000 * 5 ≤ q ∧ q < 1000 * 5 + 1000) ∨ (1000 * 6 ≤ q ∧ q < 1000 * 6 + 1000) ∨ (1000 * 7 ≤ q ∧ q < 1000 * 7 + 1000) ∨ (1000 * 8 ≤ q ∧ q < 1000 * 8 + 1000) ∨ (1000 * 9 ≤ q ∧ q < 1000 * 9 + 1000)) with
    ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩
  · exact key 0 coverOK_0 h1 h2
  · exact key 1 coverOK_1 h1 h2
  · exact key 2 coverOK_2 h1 h2
  · exact key 3 coverOK_3 h1 h2
  · exact key 4 coverOK_4 h1 h2
  · exact key 5 coverOK_5 h1 h2
  · exact key 6 coverOK_6 h1 h2
  · exact key 7 coverOK_7 h1 h2
  · exact key 8 coverOK_8 h1 h2
  · exact key 9 coverOK_9 h1 h2

/-- Every prime `q < 10 ^ 4` divides `x (q ^ 2 - 1)` (checked by certificates). -/
@[category API, AMS 11]
lemma prime_dvd_x_sq_sub_one_of_lt {q : ℕ} (hq : q.Prime) (h : q < 10 ^ 4) :
    q ∣ x (q ^ 2 - 1) := by
  have hcov := coverOK_lt h
  simp only [coverOK, Bool.or_eq_true, beq_iff_eq, Bool.not_eq_true', List.any_eq_true,
    Bool.and_eq_true, decide_eq_true_eq] at hcov
  have h2 := hq.two_le
  rcases hcov with ((((hb | rfl) | rfl) | rfl) | ⟨e, he, ⟨heq, he1⟩, heP⟩)
  · rw [primeB_of_prime hq] at hb; exact absurd hb (by decide)
  · exact (show 2 ∣ x 2 by decide).trans (x_dvd_x (by norm_num) (by norm_num))
  · exact (show 3 ∣ x 4 by decide).trans (x_dvd_x (by norm_num) (by norm_num))
  · exact (show 5 ∣ x 3 by decide).trans (x_dvd_x (by norm_num) (by norm_num))
  · have := entryOK_sound certs entryOK_certs e he
    rw [heq] at this
    exact this.trans (x_dvd_x he1 (by rw [sq]; omega))

/-- The conjecture holds whenever the least prime factor of `p - 2` is less than `10 ^ 4`. -/
@[category research solved, AMS 11]
theorem conjecture.variants.minFac_lt {p : ℕ} (hp : p.Prime) (hp_twin : ¬ (p - 2).Prime)
    (h : (p - 2).minFac < 10 ^ 4) : a (p - 1) = p := by
  rcases (by have := hp.two_le; omega : p = 2 ∨ p = 3 ∨ p = 4 ∨ 5 ≤ p) with rfl | rfl | rfl | h5
  · decide
  · decide
  · exact absurd hp (by decide)
  · have hq := Nat.minFac_prime (show p - 2 ≠ 1 by omega)
    have hsq := Nat.minFac_sq_le_self (by omega : 0 < p - 2) hp_twin
    have h2 : 2 ≤ (p - 2).minFac := hq.two_le
    refine a_pred_eq_self hp h5 hq.one_lt (Nat.minFac_dvd _)
      ((prime_dvd_x_sq_sub_one_of_lt hq h).trans (x_dvd_x ?_ (by omega)))
    have : 4 ≤ (p - 2).minFac ^ 2 := by nlinarith
    omega

/-- The conjecture holds for every prime `p < 10 ^ 8 + 2`. -/
@[category research solved, AMS 11]
theorem conjecture.variants.lt {p : ℕ} (hp : p.Prime) (hp_twin : ¬ (p - 2).Prime)
    (hlt : p < 10 ^ 8 + 2) : a (p - 1) = p := by
  rcases (by have := hp.two_le; omega : p ≤ 4 ∨ 5 ≤ p) with h4 | h5
  · have := hp.two_le
    interval_cases p
    · decide
    · decide
    · exact absurd hp (by decide)
  · refine conjecture.variants.minFac_lt hp hp_twin ?_
    have hsq := Nat.minFac_sq_le_self (by omega : 0 < p - 2) hp_twin
    by_contra h
    have : (10 ^ 4) ^ 2 ≤ (p - 2).minFac ^ 2 := Nat.pow_le_pow_left (by omega) 2
    omega

