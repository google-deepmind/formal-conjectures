/-!
# Recurrence involving LCM: $a(n) = x(n+1)/x(n) - 2$

$a(n) = x(n+1)/x(n) - 2$ where $x(1)=1$ and $x(n) = 2 x(n-1) + \operatorname{lcm}(x(n-1),n)$
for $n > 1$.

*References:*
- [A135508](https://oeis.org/A135508)-/

@[expose] public section

namespace OeisA135508

/-- Auxiliary sequence $x(n)$ with $x(1)=1$ and $x(n) = 2 x(n-1) + \operatorname{lcm}(x(n-1),n)$. -/
def x : ℕ → ℕ
  | 0 => 0
  | 1 => 1
  | n + 1 => 2 * x n + Nat.lcm (x n) (n + 1)

/-- $a(n) = x(n+1)/x(n) - 2$ for $n \ge 1$, and $a(0) = 0$. -/
def a (n : ℕ) : ℕ :=
  if n = 0 then 0 else (x (n + 1) / x n) - 2

/-- Value of the sequence `a` at 0. -/
@[category test, AMS 11]
theorem a_0 : a 0 = 0 := by rfl

/-- Value of the sequence `a` at 1. -/
@[category test, AMS 11]
theorem a_1 : a 1 = 2 := by rfl

/-- Value of the sequence `a` at 2. -/
@[category test, AMS 11]
theorem a_2 : a 2 = 3 := by rfl

/-- Value of the sequence `a` at 3. -/
@[category test, AMS 11]
theorem a_3 : a 3 = 1 := by rfl

/-- Value of the sequence `a` at 4. -/
@[category test, AMS 11]
theorem a_4 : a 4 = 1 := by rfl

/--
Conjecture: For prime $p$ such that $p-2$ is not a prime, $a(p-1) = p$.
- _Bill McEachen_, Sep 26 2025
-/
@[category research open, AMS 11]
theorem conjecture (p : ℕ) (hp : p.Prime) (hp_twin : ¬ (p - 2).Prime) : a (p - 1) = p := by
  sorry

/-- `b n = (n + 1) / gcd(x n, n + 1)`; for `n ≥ 1` this equals `a n`. -/
def b (n : ℕ) : ℕ := (n + 1) / Nat.gcd (x n) (n + 1)

/-- The defining recurrence for `n ≥ 1`. -/
@[category API, AMS 11]
lemma x_succ {n : ℕ} (hn : 1 ≤ n) : x (n + 1) = 2 * x n + Nat.lcm (x n) (n + 1) := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le' hn
  rfl

/-- `x (n + 1) = x n * (2 + b n)` for `n ≥ 1`. -/
@[category API, AMS 11]
lemma x_succ_eq {n : ℕ} (hn : 1 ≤ n) : x (n + 1) = x n * (2 + b n) := by
  rw [x_succ hn, Nat.lcm, b, Nat.mul_div_assoc _ (Nat.gcd_dvd_right _ _)]
  ring

/-- `x n > 0` for `n ≥ 1`. -/
@[category API, AMS 11]
lemma x_pos : ∀ {n : ℕ}, 1 ≤ n → 0 < x n
  | 1, _ => Nat.one_pos
  | n + 2, _ => by
    rw [x_succ_eq (by omega)]
    have := x_pos (n := n + 1) (by omega)
    positivity

/-- `a n = (n + 1) / gcd(x n, n + 1)` for `n ≥ 1`. -/
@[category API, AMS 11]
lemma a_eq_b {n : ℕ} (hn : 1 ≤ n) : a n = b n := by
  rw [a, if_neg (by omega), x_succ_eq hn, Nat.mul_div_cancel_left _ (x_pos hn)]
  omega

/-- `x n ∣ x m` for `1 ≤ n ≤ m`. -/
@[category API, AMS 11]
lemma x_dvd_x {n m : ℕ} (hn : 1 ≤ n) (h : n ≤ m) : x n ∣ x m := by
  induction m, h using Nat.le_induction with
  | base => rfl
  | succ m hm ih =>
    rw [x_succ_eq (by omega)]
    exact Dvd.dvd.mul_right ih _

/-- A prime dividing `x n` divides `2 + b j` for some `1 ≤ j < n`. -/
@[category API, AMS 11]
lemma exists_of_prime_dvd_x {p : ℕ} (hp : p.Prime) :
    ∀ {n : ℕ}, 1 ≤ n → p ∣ x n → ∃ j, 1 ≤ j ∧ j < n ∧ p ∣ 2 + b j
  | 1, _, h => absurd (Nat.dvd_one.mp h) hp.ne_one
  | n + 2, _, h => by
    rw [x_succ_eq (by omega)] at h
    rcases hp.dvd_mul.mp h with h | h
    · obtain ⟨j, h1, h2, h3⟩ := exists_of_prime_dvd_x hp (by omega) h
      exact ⟨j, h1, by omega, h3⟩
    · exact ⟨n + 1, by omega, by omega, h⟩

/-- **Reduction.** If `p ≥ 5` is prime and some prime factor `q` of `p - 2` already divides
`x (p - 3)`, then `a (p - 1) = p`. -/
@[category research solved, AMS 11]
theorem a_pred_eq_self {p q : ℕ} (hp : p.Prime) (hp5 : 5 ≤ p) (hq : 1 < q)
    (hqc : q ∣ p - 2) (hqx : q ∣ x (p - 3)) : a (p - 1) = p := by
  have hnd : ¬ p ∣ x (p - 1) := by
    intro h
    obtain ⟨j, hj1, hjp, hdvd⟩ := exists_of_prime_dvd_x hp (by omega) h
    set g := Nat.gcd (x j) (j + 1) with hg_def
    have hg0 : 0 < g := Nat.gcd_pos_of_pos_right _ (by omega)
    have hg : b j * g = j + 1 := Nat.div_mul_cancel (Nat.gcd_dvd_right _ _)
    have hble : b j ≤ j + 1 := Nat.div_le_self _ _
    have heq : 2 + b j = p :=
      Nat.eq_of_dvd_of_lt_two_mul (by omega) hdvd (by omega)
    have hg1 : g = 1 := by
      by_contra hne
      have : (p - 2) * 2 ≤ (p - 2) * g := Nat.mul_le_mul_left _ (by omega)
      have : (p - 2) * g = j + 1 := by rw [← hg]; congr 1; omega
      omega
    have hj : j = p - 3 := by rw [hg1, mul_one] at hg; omega
    have hqg : q ∣ g := Nat.dvd_gcd (hj ▸ hqx) (by rw [hj, show p - 3 + 1 = p - 2 by omega]; exact hqc)
    rw [hg1] at hqg
    exact hq.ne' (Nat.dvd_one.mp hqg)
  have hcop : Nat.gcd (x (p - 1)) p = 1 :=
    Nat.Coprime.symm ((Nat.Prime.coprime_iff_not_dvd hp).mpr hnd)
  rw [a_eq_b (by omega), b, Nat.sub_add_cancel (by omega), hcop, Nat.div_one]

/-- `x 3 = 20`. -/
@[category API, AMS 11]
lemma x_three : x 3 = 20 := by decide
/-- `x 4 = 60`. -/
@[category API, AMS 11]
lemma x_four : x 4 = 60 := by decide

/-- The conjecture holds for every prime `p ≡ 2 (mod 3)`. -/
@[category research solved, AMS 11]
theorem conjecture.variants.mod_three {p : ℕ} (hp : p.Prime) (hp_twin : ¬ (p - 2).Prime)
    (h3 : p % 3 = 2) : a (p - 1) = p := by
  rcases (by omega : p = 2 ∨ p = 5 ∨ 11 ≤ p ∨ (5 < p ∧ p < 11)) with rfl | rfl | h | h
  · decide
  · exact absurd Nat.prime_three hp_twin
  · refine a_pred_eq_self hp (by omega) Nat.prime_three.one_lt (by omega) ?_
    exact (show 3 ∣ x 4 by rw [x_four]; norm_num).trans (x_dvd_x (by norm_num) (by omega))
  · obtain rfl : p = 8 := by omega
    exact absurd hp (by decide)

/-- The conjecture holds for every prime `p ≡ 2 (mod 5)`. -/
@[category research solved, AMS 11]
theorem conjecture.variants.mod_five {p : ℕ} (hp : p.Prime) (hp_twin : ¬ (p - 2).Prime)
    (h5 : p % 5 = 2) : a (p - 1) = p := by
  rcases (by omega : p = 2 ∨ p = 7 ∨ 12 ≤ p ∨ (2 < p ∧ p < 12 ∧ p ≠ 7)) with rfl | rfl | h | h
  · decide
  · exact absurd Nat.prime_five hp_twin
  · refine a_pred_eq_self hp (by omega) Nat.prime_five.one_lt (by omega) ?_
    exact (show 5 ∣ x 3 by rw [x_three]; norm_num).trans (x_dvd_x (by norm_num) (by omega))
  · omega

/-- The conjecture follows from: every prime `q` divides `x (q ^ 2 - 1)`. -/
@[category research solved, AMS 11]
theorem conjecture.variants.of_forall_prime_dvd (H : ∀ q, q.Prime → q ∣ x (q ^ 2 - 1))
    {p : ℕ} (hp : p.Prime) (hp_twin : ¬ (p - 2).Prime) : a (p - 1) = p := by
  rcases (by have := hp.two_le; omega : p = 2 ∨ p = 3 ∨ p = 4 ∨ 5 ≤ p) with rfl | rfl | rfl | h
  · decide
  · decide
  · exact absurd hp (by decide)
  · have hc1 : p - 2 ≠ 1 := by omega
    have hq := Nat.minFac_prime hc1
    have hsq := Nat.minFac_sq_le_self (by omega : 0 < p - 2) hp_twin
    have h2 : 2 ≤ (p - 2).minFac := hq.two_le
    refine a_pred_eq_self hp h hq.one_lt (Nat.minFac_dvd _) ((H _ hq).trans (x_dvd_x ?_ (by omega)))
    have : 4 ≤ (p - 2).minFac ^ 2 := by nlinarith
    omega

/-- **Exact reduction.** For a prime `p ≥ 5`, if `x (p - 3)` is coprime to `p - 2` then
`a (p - 1) ≠ p`. Together with `a_pred_eq_self`, `a (p - 1) = p` holds iff `p - 2` shares a
prime factor with `x (p - 3)`. -/
@[category research solved, AMS 11]
theorem a_pred_ne_self {p : ℕ} (hp : p.Prime) (hp5 : 5 ≤ p)
    (hcop : Nat.Coprime (x (p - 3)) (p - 2)) : a (p - 1) ≠ p := by
  have hb : b (p - 3) = p - 2 := by
    rw [b, show p - 3 + 1 = p - 2 by omega, hcop, Nat.div_one]
  have hpx : p ∣ x (p - 1) := by
    have h := x_succ_eq (n := p - 3) (by omega)
    rw [hb, show 2 + (p - 2) = p by omega, show p - 3 + 1 = p - 2 by omega] at h
    exact (h ▸ dvd_mul_left p _).trans (x_dvd_x (by omega) (by omega))
  rw [a_eq_b (by omega), b, Nat.sub_add_cancel (by omega),
    Nat.gcd_eq_right hpx, Nat.div_self hp.pos]
  exact hp.one_lt.ne

/-! ### Certificates -/

/-- Trial division from `d`: `true` iff no `k ≥ d` with `k * k ≤ n` divides `n`
(given enough `fuel`). -/
def noDiv (n : ℕ) : ℕ → ℕ → Bool
  | _, 0 => true
  | d, fuel + 1 => if n < d * d then true else (n % d != 0 && noDiv n (d + 1) fuel)

/-- A kernel-friendly primality test. -/
def primeB (n : ℕ) : Bool := 2 ≤ n && noDiv n 2 n

/-- Soundness of `noDiv`. -/
@[category API, AMS 11]
lemma noDiv_spec {n : ℕ} : ∀ {fuel d : ℕ}, noDiv n d fuel = true →
    ∀ k, d ≤ k → k < d + fuel → k * k ≤ n → ¬ k ∣ n
  | 0, d, _, k, h1, h2, _ => by omega
  | fuel + 1, d, h, k, h1, h2, h3 => by
    unfold noDiv at h
    split_ifs at h with hlt
    · have : d * d ≤ k * k := Nat.mul_le_mul h1 h1
      omega
    · simp only [Bool.and_eq_true, bne_iff_ne, ne_eq] at h
      rcases Nat.eq_or_lt_of_le h1 with rfl | h1'
      · rw [Nat.dvd_iff_mod_eq_zero]; exact h.1
      · exact noDiv_spec h.2 k h1' (by omega) h3

/-- `primeB` only accepts primes. -/
@[category API, AMS 11]
lemma primeB_sound {n : ℕ} (h : primeB n = true) : n.Prime := by
  simp only [primeB, Bool.and_eq_true, decide_eq_true_eq] at h
  by_contra hp
  have hsq := Nat.minFac_sq_le_self (by omega) hp
  have h2 := (Nat.minFac_prime (by omega : n ≠ 1)).two_le
  have hle : n.minFac ≤ n := Nat.minFac_le (by omega)
  exact noDiv_spec h.2 _ h2 (by omega) (by nlinarith) (Nat.minFac_dvd n)

/-- `noDiv` accepts every prime. -/
@[category API, AMS 11]
lemma noDiv_of_prime {n : ℕ} (hn : n.Prime) : ∀ {fuel d : ℕ}, 2 ≤ d → noDiv n d fuel = true
  | 0, _, _ => rfl
  | fuel + 1, d, hd => by
    unfold noDiv
    split_ifs with hlt
    · rfl
    · simp only [Bool.and_eq_true, bne_iff_ne, ne_eq]
      refine ⟨fun hmod => ?_, noDiv_of_prime hn (by omega)⟩
      have hdvd : d ∣ n := Nat.dvd_of_mod_eq_zero hmod
      rcases (Nat.dvd_prime hn).mp hdvd with h | h
      · omega
      · subst h; nlinarith

/-- `primeB` accepts every prime. -/
@[category API, AMS 11]
lemma primeB_of_prime {n : ℕ} (hn : n.Prime) : primeB n = true := by
  simp only [primeB, Bool.and_eq_true, decide_eq_true_eq]
  exact ⟨hn.two_le, noDiv_of_prime hn le_rfl⟩

/-- If `P ≥ 5` is prime and `1 < s` divides both `P - 2` and `x (P - 3)`, then `P + 2 ∣ x P`. -/
@[category API, AMS 11]
lemma add_two_dvd_x {P s : ℕ} (hP : P.Prime) (hP5 : 5 ≤ P) (hs : 1 < s) (hsP : s ∣ P - 2)
    (hsx : s ∣ x (P - 3)) : P + 2 ∣ x P := by
  have ha := a_pred_eq_self hP hP5 hs hsP hsx
  rw [a_eq_b (by omega)] at ha
  have h := x_succ_eq (n := P - 1) (by omega)
  rw [ha, Nat.sub_add_cancel (by omega)] at h
  rw [h, add_comm]
  exact dvd_mul_left _ _

/-- Known small facts: `2 ∣ x 2`, `3 ∣ x 4`, `5 ∣ x 3`. -/
def base : List (ℕ × ℕ) := [(2, 2), (3, 4), (5, 3)]

/-- The facts in `base` hold. -/
@[category API, AMS 11]
lemma base_sound : ∀ e ∈ base, 1 ≤ e.2 ∧ e.1 ∣ x e.2 := by decide

/-- Checks one certificate `(q, P, s)` against the list `L`: `P ≥ 5` is prime, `q ∣ P + 2`,
`1 < s ∣ P - 2`, and `s ∣ x N` is known for some `N ≤ P - 3`, either from `base` or from an
entry `(s, N, _)` of `L`. -/
def entryOK (L : List (ℕ × ℕ × ℕ)) (e : ℕ × ℕ × ℕ) : Bool :=
  5 ≤ e.2.1 && primeB e.2.1 && (e.2.1 + 2) % e.1 == 0 && 2 ≤ e.2.2 &&
    (e.2.1 - 2) % e.2.2 == 0 &&
    ((base.any fun f => f.1 == e.2.2 && 1 ≤ f.2 && f.2 + 3 ≤ e.2.1) ||
      (L.any fun f => f.1 == e.2.2 && f.2.1 + 3 ≤ e.2.1))

/-- If every certificate in `L` passes `entryOK L`, then `q ∣ x P` for every `(q, P, s) ∈ L`. -/
@[category API, AMS 11]
lemma entryOK_sound (L : List (ℕ × ℕ × ℕ)) (hL : ∀ e ∈ L, entryOK L e = true) :
    ∀ e ∈ L, e.1 ∣ x e.2.1 := by
  suffices H : ∀ n, ∀ e ∈ L, e.2.1 = n → e.1 ∣ x e.2.1 from fun e he => H _ e he rfl
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro e he hen
    have h := hL e he
    simp only [entryOK, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq, Bool.or_eq_true,
      List.any_eq_true] at h
    obtain ⟨⟨⟨⟨⟨hP5, hPp⟩, hq⟩, hs⟩, hsP⟩, hfact⟩ := h
    have hsx : e.2.2 ∣ x (e.2.1 - 3) := by
      rcases hfact with ⟨f, hf, ⟨hfs, hf1⟩, hfP⟩ | ⟨f, hf, hfs, hfP⟩
      · rw [← hfs]; exact (base_sound f hf).2.trans (x_dvd_x hf1 (by omega))
      · have hf5 : 5 ≤ f.2.1 := by
          have := hL f hf
          simp only [entryOK, Bool.and_eq_true, decide_eq_true_eq] at this
          exact this.1.1.1.1.1
        rw [← hfs]
        exact (ih f.2.1 (by omega) f hf rfl).trans (x_dvd_x (by omega) (by omega))
    exact (Nat.dvd_of_mod_eq_zero hq).trans
      (add_two_dvd_x (primeB_sound hPp) hP5 (by omega) (Nat.dvd_of_mod_eq_zero hsP) hsx)

