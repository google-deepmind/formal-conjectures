module

public import FormalConjecturesUtil

/-!
# Periods of the Bell numbers modulo a prime

For a prime $p$ the Bell numbers modulo $p$ are periodic with period $(p^p - 1)/(p - 1)$ (Touchard
1933; Hall 1934; see also Williams 1945). G. C. Greubel conjectured the periods of the Bell numbers
modulo $17, 19, 23, 29, 31$ (A146107, A146109, A146113, A146119, A146121); these are the instances
$p = 17, \ldots, 31$. Minimality of the period is Radoux's conjecture (A054767) and is not stated
here.

*References:*
- [A054767](https://oeis.org/A054767); [A146107](https://oeis.org/A146107),
  [A146109](https://oeis.org/A146109), [A146113](https://oeis.org/A146113),
  [A146119](https://oeis.org/A146119), [A146121](https://oeis.org/A146121) (N. J. A. Sloane, Feb 07
  2009; conjectures by G. C. Greubel).
- J. Touchard, *Propriétés arithmétiques de certains nombres récurrents*, Ann. Soc. Sci. Bruxelles A
  53 (1933), 21–31.
- M. Hall, *Arithmetic properties of a partition function*, Bull. Amer. Math. Soc. 40 (1934), 387.
- G. T. Williams, *Numbers generated by the function $e^{e^x - 1}$*, Amer. Math. Monthly 52 (1945),
  323–327.
-/

@[expose] public section

namespace OeisA54767

/-- The Bell numbers read modulo `p`. -/
def a (p n : ℕ) : ℕ := Nat.bell n % p

/--
For every prime $p$, $(p^p - 1)/(p - 1)$ is a period of the Bell numbers modulo $p$
(Touchard 1933; Hall 1934; Williams 1945).
-/
@[category research solved, AMS 5 11, formal_proof using lean4 at
  "https://palomar-registry.org/entry.html?id=PALOMAR-2026-11-19-000003"]
theorem bell_period :
    ∀ p : ℕ, p.Prime → ∀ n : ℕ, a p (n + (p ^ p - 1) / (p - 1)) = a p n := by
  sorry

/--
A146107: the Bell numbers modulo $17$ have period $(17^{17} - 1)/16$ (G. C. Greubel).
-/
@[category research solved, AMS 5 11, formal_proof using lean4 at
  "https://palomar-registry.org/entry.html?id=PALOMAR-2026-11-19-000003"]
theorem a146107 :
    ∀ n : ℕ, a 17 (n + 51702516367896047761) = a 17 n := by
  sorry

/--
A146109: the Bell numbers modulo $19$ have period $(19^{19} - 1)/18$ (G. C. Greubel).
-/
@[category research solved, AMS 5 11, formal_proof using lean4 at
  "https://palomar-registry.org/entry.html?id=PALOMAR-2026-11-19-000003"]
theorem a146109 :
    ∀ n : ℕ, a 19 (n + 109912203092239643840221) = a 19 n := by
  sorry

/--
A146113: the Bell numbers modulo $23$ have period $(23^{23} - 1)/22$ (G. C. Greubel).
-/
@[category research solved, AMS 5 11, formal_proof using lean4 at
  "https://palomar-registry.org/entry.html?id=PALOMAR-2026-11-19-000003"]
theorem a146113 :
    ∀ n : ℕ, a 23 (n + 949112181811268728834319677753) = a 23 n := by
  sorry

/--
A146119: the Bell numbers modulo $29$ have period $(29^{29} - 1)/28$ (G. C. Greubel).
-/
@[category research solved, AMS 5 11, formal_proof using lean4 at
  "https://palomar-registry.org/entry.html?id=PALOMAR-2026-11-19-000003"]
theorem a146119 :
    ∀ n : ℕ, a 29 (n + 91703076898614683377208150526107718802981) = a 29 n := by
  sorry

/--
A146121: the Bell numbers modulo $31$ have period $(31^{31} - 1)/30$ (G. C. Greubel).
-/
@[category research solved, AMS 5 11, formal_proof using lean4 at
  "https://palomar-registry.org/entry.html?id=PALOMAR-2026-11-19-000003"]
theorem a146121 :
    ∀ n : ℕ, a 31 (n + 568972471024107865287021434301977158534824481) = a 31 n := by
  sorry

end OeisA54767
