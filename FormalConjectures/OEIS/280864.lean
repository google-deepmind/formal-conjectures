@[category test, AMS 11]
theorem a_7 : TermAt 7 5 := by
  exact ⟨by decide, initialPrefix, initialPrefix_valid, by decide⟩

@[category test, AMS 11]
theorem a_8 : TermAt 8 10 := by
  exact ⟨by decide, initialPrefix, initialPrefix_valid, by decide⟩

@[category test, AMS 11]
theorem a_9 : TermAt 9 12 := by
  exact ⟨by decide, initialPrefix, initialPrefix_valid, by decide⟩

@[category test, AMS 11]
theorem a_10 : TermAt 10 9 := by
  exact ⟨by decide, initialPrefix, initialPrefix_valid, by decide⟩

/--
[OEIS A280864](https://oeis.org/A280864) states:
"Conjectured to be a permutation of the positive integers."
-/
@[category research open, AMS 11]
theorem conjecture :
    ∃ a : ℕ → ℕ, FollowsRule a ∧ ∀ k > 0, ∃ n, a n = k := by
  sorry

end OeisA280864
