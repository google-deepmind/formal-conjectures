{
  "problemMatcher": [
    {
      "owner": "lean",
      "pattern": [
        {
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(warning|error|info):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      ]
    }
  ]
}
