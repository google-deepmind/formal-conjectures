# macOS leaves these files everywhere:
.DS_Store
# Created by `lake exe cache get` if no home directory is available
.cache
# `lake` stores its files here:
.lake

# Verso literate build output (generated by `lake build :literate` + `verso-html`)
_literate_html/
# Built site output (generated by `node site/build.js`)
site/site/
# Generated or downloaded website data
site/data/conjectures.json
site/data/verso-fragments.json
site/data/catalog.json
site/data/catalog-manifest.json
site/data/evidence.json
site/data/work.json

# Generated all-imports file
FormalConjectures.lean
FormalConjectures/All.lean

# Python bytecode from the scripts in `scripts/`.
__pycache__/

# Generated review bundles and model-evaluation runs; benchmark inputs stay tracked.
/review-artifacts/
/.agents/skills/formal-conjectures-review/evals/results/

# Local contribution runs and operator configuration
.conjectures/

# Python package build output
*.egg-info/
build/
dist/
