import WeilAutocorrelationClosureV1
import WeilSeparatedArchBridgeV31
import Mathlib.Tactic

/-!
AEGIS Ω — final RH closure spine v1.

This module does not assert RH. It consolidates the already-existing proof
surface into one exact final sign target.

FinalSignResidualV1 is the universal arithmetic nonpositivity statement
already isolated by the restricted Bombieri/Weil criterion work:

  ∀ g, moments(g) →
    Re (WeilExplicitRightSideV1 (WeilAutocorrelationV1 g)) ≤ 0.

The repository has already proved that convergence/reality are automatic for
the autocorrelation carrier, so this residual is exactly equivalent to
WeilCompactSmoothNegativityV1.

The V3.1 retained three-block theorem is then recorded as an actual solved
subclass of this sign target.

No assumption, axiom, parameter, sorry, or RH promotion is introduced.
-/

open Set MeasureTheory Complex

set_option autoImplicit false
noncomputable section

namespace AEGIS.RHFinalClosureV1

/-- The one remaining arithmetic sign proposition after autocorrelation
closure, convergence, and reality have been discharged. -/
def FinalSignResidualV1 : Prop :=
  ∀ g : WeilCompactSmoothGV1,
    WeilMomentConditionsV1 g →
    (WeilExplicitRightSideV1 (WeilAutocorrelationV1 g)).re ≤ 0

/-- The final sign residual is exactly the repository's restricted
Bombieri/Weil negativity predicate. -/
theorem final_sign_residual_iff_weil_negativity_v1 :
    FinalSignResidualV1 ↔ WeilCompactSmoothNegativityV1 := by
  simpa [FinalSignResidualV1] using
    (Iff.symm weil_compact_smooth_negativity_iff_unconditional_real_inequality_v1)

/-- V3.1 already proves the final sign inequality on the retained
correlation-window width-1/16 three-block family generated by width-1/32 packets. -/
theorem retained_three_block_sign_v1
    (g : WeilCompactSmoothGV1) (a : ℝ)
    (hw : AEGIS.WeilThreeBlockTranslatedPacketsV22.WidthOneThirtyTwoAt g a)
    (hm : WeilMomentConditionsV1 g)
    (z0 z1 z2 : ℂ) :
    (WeilExplicitRightSideV1
      (WeilAutocorrelationV1
        (AEGIS.WeilMixedAlgebraV2.combo z0 z1 z2
          (AEGIS.WeilThreeBlockTranslatedPacketsV22.gMinus g)
          (AEGIS.WeilThreeBlockTranslatedPacketsV22.gZero g)
          (AEGIS.WeilThreeBlockTranslatedPacketsV22.gPlus g)))).re ≤ 0 := by
  have h :=
    AEGIS.WeilSeparatedArchBridgeV31.three_block_bound_of_moments
      g a hw hm z0 z1 z2
  have hE :
      0 ≤ AEGIS.WeilDisjointEnergyV2.energy
        (AEGIS.WeilMixedAlgebraV2.combo z0 z1 z2
          (AEGIS.WeilThreeBlockTranslatedPacketsV22.gMinus g)
          (AEGIS.WeilThreeBlockTranslatedPacketsV22.gZero g)
          (AEGIS.WeilThreeBlockTranslatedPacketsV22.gPlus g)).1 :=
    AEGIS.WeilDisjointEnergyV2.energy_nonnegative _
  nlinarith

end AEGIS.RHFinalClosureV1

#print axioms AEGIS.RHFinalClosureV1.final_sign_residual_iff_weil_negativity_v1
#print axioms AEGIS.RHFinalClosureV1.retained_three_block_sign_v1
