#print axioms AEGIS.RHMomentPotentialV4.potential_hasDerivAt_v4
#print axioms AEGIS.RHMomentPotentialV4.potential_deriv_v4
#print axioms AEGIS.RHMomentPotentialV4.momentKiller_potential_v4
#print axioms AEGIS.RHMomentPotentialV4.potential_at_anchor_v4
#print axioms AEGIS.RHMomentPotentialV4.potential_zero_of_primitive_zeros_v4
#print axioms AEGIS.RHMomentPotentialV4.localization_product_rule_v4
