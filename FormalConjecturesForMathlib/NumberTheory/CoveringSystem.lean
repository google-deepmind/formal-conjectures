@[expose] public section

open Pointwise

/-- In `[0, L)` there are exactly `L / d` integers congruent to `v` modulo `d`, if `d ∣ L`. -/
theorem Int.card_Ico_filter_modEq_of_dvd {d L : ℕ} (hd : 0 < d) (hdL : d ∣ L) (v : ℤ) :
    ((Finset.Ico (0 : ℤ) L).filter (fun x => x ≡ v [ZMOD d])).card = L / d := by
  obtain ⟨k, rfl⟩ := hdL
  have hd' : (0 : ℤ) < d := by exact_mod_cast hd
  have h := Int.Ico_filter_modEq_card 0 ((d * k : ℕ) : ℤ) hd' v
  have e : ((((d * k : ℕ) : ℤ) : ℚ) - v) / ((d : ℤ) : ℚ) =
      (k : ℤ) + ((0 : ℤ) - v) / ((d : ℤ) : ℚ) := by
    push_cast
    field_simp
    ring
  rw [e, Int.ceil_intCast_add] at h
  rw [Nat.mul_div_cancel_left _ hd]
  have : max ((k : ℤ) + ⌈((0 : ℤ) - v : ℚ) / ((d : ℤ) : ℚ)⌉ -
      ⌈((0 : ℤ) - v : ℚ) / ((d : ℤ) : ℚ)⌉) 0 = k := by
    simp
  push_cast at h this
  rw [this] at h
  exact_mod_cast h

/--
A covering system of a semiring `R` is a finite set of cosets of non-zero ideals whose union
covers the whole ring. In the case where `R = ℤ`, this corresponds to a choice of finitely many
congruence relations such that every integer satisfies at least one of the relations.
-/
structure CoveringSystem (R : Type*) [CommSemiring R] where
  ι : Type
  [fintypeIndex : Fintype ι]
  residue : ι → R
  moduli : ι → Ideal R
  unionCovers : ⋃ i, ({residue i} : Set R) + (moduli i : Set R) = @Set.univ R
  ne_bot : ∀ i, moduli i ≠ ⊥
  ne_top : ∀ i, moduli i ≠ ⊤

/--
We say a covering system is strict if all the congruence relations that define it are take modulo
a different ideal (or number).

Note: this corresponds to the notion of a covering system that Erdos was using in
[ErGr80] Erdős, P. and Graham, R., Old and new problems and results in combinatorial number theory. Monographies de L'Enseignement Mathematique (1980).
-/
structure StrictCoveringSystem (R : Type*) [CommSemiring R] extends CoveringSystem R where
  injective_moduli : moduli.Injective

namespace CoveringSystem

variable {R : Type*} [CommSemiring R]

def coset (c : CoveringSystem R) (i : c.ι) : Set R :=
  {c.residue i} + c.moduli i

@[simp]
theorem iUnion_cosets (c : CoveringSystem R) : ⋃ i, c.coset i = Set.univ :=
  c.unionCovers

section Int

attribute [local instance] CoveringSystem.fintypeIndex

variable (c : CoveringSystem ℤ)

/-- The positive generator of the `i`-th modulus of a covering system of `ℤ`. -/
noncomputable def modulus (i : c.ι) : ℕ :=
  (Submodule.IsPrincipal.generator (c.moduli i)).natAbs

/-- The `i`-th modulus ideal is generated by `c.modulus i`. -/
theorem moduli_eq_span_modulus (i : c.ι) : c.moduli i = Ideal.span {(c.modulus i : ℤ)} := by
  rw [modulus, Int.span_natAbs, Ideal.span, Submodule.IsPrincipal.span_singleton_generator]

/-- Every modulus of a covering system of `ℤ` is greater than `1`. -/
theorem one_lt_modulus (i : c.ι) : 1 < c.modulus i := by
  have hb := c.ne_bot i
  have ht := c.ne_top i
  rw [moduli_eq_span_modulus] at hb ht
  rw [Ne, Ideal.span_singleton_eq_bot] at hb
  rw [Ne, Ideal.span_singleton_eq_top] at ht
  have h0 : c.modulus i ≠ 0 := by exact_mod_cast hb
  have h1 : c.modulus i ≠ 1 := by rintro h; exact ht (by simp [h])
  omega

/-- Every integer satisfies at least one congruence of the covering system. -/
theorem exists_modEq (x : ℤ) : ∃ i, x ≡ c.residue i [ZMOD c.modulus i] := by
  have hx : x ∈ ⋃ i, c.coset i := by simp
  obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hx
  obtain ⟨a, ha, m, hm, rfl⟩ := hi
  rw [Set.mem_singleton_iff] at ha
  subst ha
  refine ⟨i, ?_⟩
  have hm' : m ∈ Ideal.span {(c.modulus i : ℤ)} := by rw [← moduli_eq_span_modulus]; exact hm
  rw [Ideal.mem_span_singleton] at hm'
  rw [Int.modEq_iff_dvd]
  simpa using hm'

/-- The reciprocals of the moduli of a covering system of `ℤ` sum to at least `1`. -/
theorem one_le_sum_inv_modulus : 1 ≤ ∑ i, (1 : ℚ) / c.modulus i := by
  classical
  set L : ℕ := ∏ i, c.modulus i
  have hpos : ∀ i, 0 < c.modulus i := fun i => by have := c.one_lt_modulus i; omega
  have hLpos : 0 < L := Finset.prod_pos fun i _ => hpos i
  have hdvd : ∀ i, c.modulus i ∣ L := fun i => Finset.dvd_prod_of_mem _ (Finset.mem_univ i)
  have hsub : Finset.Ico (0 : ℤ) L ⊆ Finset.univ.biUnion
      (fun i => (Finset.Ico (0 : ℤ) L).filter
        (fun x => x ≡ c.residue i [ZMOD c.modulus i])) := by
    intro x hx
    obtain ⟨i, hi⟩ := c.exists_modEq x
    exact Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _, Finset.mem_filter.mpr ⟨hx, hi⟩⟩
  have hcard : L ≤ ∑ i, L / c.modulus i := by
    have h1 := (Finset.card_le_card hsub).trans Finset.card_biUnion_le
    simpa [Int.card_Ico_filter_modEq_of_dvd (hpos _) (hdvd _)] using h1
  have hcardQ : (L : ℚ) ≤ ∑ i, (L : ℚ) / c.modulus i := by
    have := (Nat.cast_le (α := ℚ)).mpr hcard
    push_cast at this
    refine this.trans (le_of_eq ?_)
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Nat.cast_div (hdvd i) (by exact_mod_cast (hpos i).ne')]
  have hLQ : (0 : ℚ) < L := by exact_mod_cast hLpos
  have hsum : ∑ i, (L : ℚ) / c.modulus i = L * ∑ i, (1 : ℚ) / c.modulus i := by
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun i _ => (mul_one_div _ _).symm
  rw [hsum] at hcardQ
  exact le_of_mul_le_mul_left (by simpa using hcardQ) hLQ

end Int

end CoveringSystem
