module

public import Mathlib.Algebra.BigOperators.Group.Finset.Basic
public import Mathlib.Data.Finset.Powerset
public import Mathlib.Data.Set.Pairwise.Basic
public import Mathlib.Tactic.ToAdditive

/-!
# Distinct subset products and sums

Shared predicates for sets whose finite subsets have distinct products or sums.
The additive definitions and lemmas are generated by `to_additive`.
-/

@[expose] public section

/-- All finite subsets of a set have distinct products, including the empty subset. -/
@[to_additive Set.DistinctSubsetSums
  /-- All finite subsets of a set have distinct sums, including the empty subset. -/]
def Set.DistinctSubsetProducts {M : Type*} [CommMonoid M] (A : Set M) : Prop :=
  Set.Pairwise {X : Finset M | ↑X ⊆ A} fun X Y => X.prod id ≠ Y.prod id

/-- A finite predicate expressing distinct subset products. -/
@[to_additive Finset.DecidableDistinctSubsetSums
  /-- A finite predicate expressing distinct subset sums. -/]
def Finset.DecidableDistinctSubsetProducts {M : Type*} [CommMonoid M] [DecidableEq M]
    (A : Finset M) : Prop :=
  ∀ X ⊆ A, ∀ Y ⊆ A, X ≠ Y → X.prod id ≠ Y.prod id

@[to_additive Finset.decidableDistinctSubsetSums]
instance Finset.decidableDistinctSubsetProducts {M : Type*} [CommMonoid M] [DecidableEq M]
    (A : Finset M) : Decidable A.DecidableDistinctSubsetProducts := by
  unfold Finset.DecidableDistinctSubsetProducts
  infer_instance

@[to_additive Set.distinctSubsetSums_coe_iff]
theorem Set.distinctSubsetProducts_coe_iff {M : Type*} [CommMonoid M] [DecidableEq M]
    (A : Finset M) :
    Set.DistinctSubsetProducts (A : Set M) ↔ A.DecidableDistinctSubsetProducts := by
  simp [Set.DistinctSubsetProducts, Finset.DecidableDistinctSubsetProducts, Set.Pairwise]

@[to_additive Finset.decidableDistinctSubsetSums_iff_injOn]
theorem Finset.decidableDistinctSubsetProducts_iff_injOn
    {M : Type*} [CommMonoid M] [DecidableEq M] (A : Finset M) :
    A.DecidableDistinctSubsetProducts ↔
      Set.InjOn (fun X : Finset M => X.prod id) (A.powerset : Set (Finset M)) := by
  simp only [Finset.DecidableDistinctSubsetProducts, Set.InjOn,
    Finset.mem_coe, Finset.mem_powerset]
  constructor
  · intro h X hX Y hY hprod
    by_contra hne
    exact h X hX Y hY hne hprod
  · intro h X hX Y hY hne hprod
    exact hne (h hX hY hprod)
