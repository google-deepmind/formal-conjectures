{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FC proof evaluation suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "execution", "cases"],
  "properties": {
    "schema_version": {"const": "fc.proof-suite.v1"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "commit": {"$ref": "#/$defs/commit"}
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["solver_image", "verifier_image", "toolkit_commit", "agent_seconds"],
      "properties": {
        "solver_image": {"$ref": "#/$defs/image"},
        "verifier_image": {"$ref": "#/$defs/image"},
        "toolkit_commit": {"$ref": "#/$defs/commit"},
        "agent_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
      }
    },
    "cases": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "declaration", "exposure"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
          "declaration": {"type": "string", "minLength": 1},
          "exposure": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "image": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:-]*@sha256:[a-f0-9]{64}$"}
  }
}
